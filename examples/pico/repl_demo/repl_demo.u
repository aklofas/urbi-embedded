// examples/pico/repl_demo/repl_demo.u — the boot workload of the Pico demo.
//
// Baked into repl_demo_baked.h by the host `urbi --dump-wire-format` at
// build time and loaded into the main realm with urbi_load, before the
// eval service starts.  The board verbs (led_on, led_off, led_toggle,
// led_pwm, temp_celsius, button_pressed) live on Lobby and the two
// events (pressed, tick) on Object, so every REPL session sees them
// unqualified, the same way it sees echo.
//
// `boot` is the tag over everything installed here.  It is stored on
// Object for the same reason: a session's own connection tag never
// covers these watchers, so `boot.stop()` from a session is how the
// board is taken over from the REPL.
var Object.boot = Tag.new("boot");
boot: at (pressed?) led_toggle();
boot: every (1s) { if (temp_celsius() > 45.0) echo("warm") };
