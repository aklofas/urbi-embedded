// SPDX-License-Identifier: BSD-3-Clause
// Mandelbrot set demo for STM32F429I-DISC1.
// Progressive refinement (levels 32 -> 1).
// Tilt-to-pan via L3GD20 gyro (host timer fires gyro_tick every 50ms).
// USER button (PA0) zooms 2x at current center.
//
// v1.0 lex/emit guardrails in effect:
//   * No `[...]`  list literal  — use List.new(...).
//   * No `&&`/`||` shortcut    — nested if / boolean flag.
//   * No `!bool`               — use == false (OP_NEG fails on UVAL_BOOL).
//   * No `&` for bitwise AND   — use .bitand(mask).
//   * No `every(T)` keyword    — not yet landed; gyro poll driven by a
//     host-timer-injected `gyro_tick` event (50ms TIM2 ISR in main.c).
//   * UVAL_INT is always truthy — use true/false for boolean flags.
//   * Top-level vars are Realm globals; reactive bodies access them as
//     Realm.X so the emitter resolves them via OP_GETSLOT on Realm.

// === World parameters ======================================================
Realm.W        = 320;
Realm.H        = 240;
Realm.MAX_ITER = 100;

// View centre and half-span.
Realm.cx   = -0.5;
Realm.cy   = 0.0;
Realm.span = 3.0;

// Set to true when the view changes; main loop aborts and restarts render.
Realm.redraw_requested = false;

// Gyro integrator (degrees/s scaled to fraction of span per poll tick).
Realm.pan_dx = 0.0;
Realm.pan_dy = 0.0;

// Gyro deadzone (mdeg/s): the L3GD20 reports a small nonzero rate at rest
// (bias + noise).  Without a deadzone that bias integrates into pan_dx/pan_dy
// every 50 ms tick until it crosses the pan threshold, so the view drifts and
// the progressive render restarts coarse before it can refine.  Only integrate
// rotation whose magnitude exceeds this threshold = intentional tilt.  Tune to
// the board's resting bias if drift persists.
Realm.GYRO_DEADZONE = 3000.0;

// === Mandelbrot iteration ==================================================
//
// Returns iteration count in [0, MAX_ITER].  Uses local float variables for
// the escape orbit so each call is self-contained.
Realm.mandel = function (px, py) {
    var x0 = Realm.cx - Realm.span * 0.5 + Realm.span * px / Realm.W;
    var y0 = Realm.cy - Realm.span * 0.5 * Realm.H / Realm.W
             + Realm.span * Realm.H / Realm.W * py / Realm.H;
    var x  = 0.0;
    var y  = 0.0;
    var i  = 0;
    while (x * x + y * y < 4.0) {
        if (i >= Realm.MAX_ITER) {
            x = 4.0    // force exit: x*x = 16 >= 4 breaks the while
        } else {
            var xt = x * x - y * y + x0;
            y = 2.0 * x * y + y0;
            x = xt;
            i = i + 1
        }
    };
    i
};

// === RGB565 colour map =====================================================
//
// Returns a 16-bit RGB565 word.  Inside-set pixels are black; exterior
// pixels follow a 5-band gradient that mimics the canonical Wikipedia
// Mandelbrot palette: deep blue -> cyan -> near-white -> orange -> black.
// MAX_ITER is 100 so each band is 20 iter wide.
//
// v1.0 urbi note: `<<` is the sequential-atomic separator, `|` is also a
// separator; bitwise shift/or aren't operators.  Each channel occupies
// disjoint bits in RGB565 (R5 = bits 11..15, G6 = 5..10, B5 = 0..4) so
// `+` substitutes for `|` and `* 2048` / `* 32` substitute for shifts.
Realm.color_for = function (iter) {
    if (iter >= Realm.MAX_ITER) {
        0
    } else {
        if (iter < 20) {
            // Band 0: dark blue ramp.  B5 = 5..24, R = G = 0.
            5 + iter
        } else {
            if (iter < 40) {
                // Band 1: deep blue -> cyan-blue.  G6 grows 0..19, B5
                // climbs and saturates near 31.
                var g = iter - 20;
                var b = 25 + (iter - 20);
                if (b > 31) { b = 31 };
                g * 32 + b
            } else {
                if (iter < 60) {
                    // Band 2: cyan-blue -> near-white.  R5 grows 0..19,
                    // G6 holds at 50, B5 holds at 31.
                    var r5 = iter - 40;
                    if (r5 > 31) { r5 = 31 };
                    r5 * 2048 + 50 * 32 + 31
                } else {
                    if (iter < 80) {
                        // Band 3: white -> orange.  R5 = 31, G6 = 50,
                        // B5 fades 31 -> 0.
                        var b = 31 - (iter - 60) * 2;
                        if (b < 0) { b = 0 };
                        31 * 2048 + 50 * 32 + b
                    } else {
                        // Band 4: orange -> dark red -> black.  R5 + G6
                        // fade together; near MAX_ITER pixels blend into
                        // the set's black interior.
                        var fade = 99 - iter;
                        fade * 2048 + fade * 32
                    }
                }
            }
        }
    }
};

// === Render one refinement level ==========================================
//
// Fills the screen with L×L tiles; polls redraw_requested between tiles and
// aborts early if set.  Inner/outer loop exits are done by jumping to the
// end value since urbiscript has no `break` keyword at v1.0.
Realm.render_level = function (L) {
    var y = 0;
    while (y < Realm.H) {
        var x = 0;
        while (x < Realm.W) {
            if (Realm.redraw_requested == false) {
                lcd_fill_rect(x, y, L, L,
                    Realm.color_for(Realm.mandel(x, y)));
                x = x + L
            } else {
                x = Realm.W    // abort inner loop
            }
        };
        if (Realm.redraw_requested == false) {
            y = y + L
        } else {
            y = Realm.H    // abort outer loop
        }
    }
};

// === Full progressive render ===============================================
//
// Coarse-to-fine: 32 → 16 → 8 → 4 → 2 → 1 pixel tile size.
// Aborts each level pass as soon as redraw_requested becomes true.
Realm.render_all = function () {
    var levels = List.new(32, 16, 8, 4, 2, 1);
    var i = 0;
    while (i < levels.length()) {
        if (Realm.redraw_requested == false) {
            Realm.render_level(levels.get(i));
            i = i + 1
        } else {
            i = levels.length()    // abort level loop
        }
    }
};

// === Gyro poll handler =====================================================
//
// `gyro_tick` is a host-registered event fired by the TIM2 ISR every 50ms
// (registered in main.c via urbi_event_register).
// gyro_x()/gyro_y() call BSP_GYRO_GetXYZ — each is a separate SPI
// transaction returning the respective axis in mdeg/s.
//
// Accumulate into pan_dx/pan_dy; apply pan only when accumulated drift
// exceeds 0.01 fraction of the current view span.  Nested if replaces
// the || shortcut (not available at v1.0).
// Gyro intensity bar — always-on indicator that lives at the "top"
// edge (which is the LEFT in landscape orientation per the LCD
// rotation in port_lcd.c).  Color = magnitude of gyro Y rotation:
//   green   -> stationary / drift only
//   yellow  -> slight motion
//   orange  -> moderate tilt
//   red     -> vigorous tilt
//
// Bar refreshes every 50ms tick.  Render_all overpaints between ticks,
// so bar will visibly flash as render proceeds + body refreshes.  No
// redraw_requested trigger -> no OOM cascade.
//
// To see the color change: hold board still (green), then tilt
// progressively faster (color climbs through yellow -> orange -> red).
// Gyro pan: integrate angular velocity into pan_dx/pan_dy; on each tick
// shift the view if drift exceeds a threshold fraction of the current span.
// Also paint an intensity bar at the top so the user can see the gyro is alive.
at (gyro_tick?) {
    var gx = gyro_x();
    var gy = gyro_y();
    var gz = gyro_z();
    // Integrate (50ms tick, gyro in mdeg/s).  Axes are mapped through
    // the LCD's 90° CCW rotation: physical-X gyro drives horizontal pan,
    // physical-Y gyro drives vertical pan.  Empirically tuned 2026-05-17
    // for the landscape view.
    //
    // Deadzone: only integrate rotation above GYRO_DEADZONE so at-rest bias
    // does not accumulate into a drifting pan.  v1.0 urbiscript has no ||/abs,
    // so test each sign with a separate if (0.0 - D is the negative bound).
    if (gx > Realm.GYRO_DEADZONE) {
        Realm.pan_dx = Realm.pan_dx + gx * 0.000002 * Realm.span
    };
    if (gx < 0.0 - Realm.GYRO_DEADZONE) {
        Realm.pan_dx = Realm.pan_dx + gx * 0.000002 * Realm.span
    };
    if (gy > Realm.GYRO_DEADZONE) {
        Realm.pan_dy = Realm.pan_dy + gy * 0.000002 * Realm.span
    };
    if (gy < 0.0 - Realm.GYRO_DEADZONE) {
        Realm.pan_dy = Realm.pan_dy + gy * 0.000002 * Realm.span
    };
    if (Realm.pan_dx > 0.01 * Realm.span) {
        Realm.cx = Realm.cx + Realm.pan_dx;
        Realm.pan_dx = 0.0;
        Realm.redraw_requested = true
    };
    if (Realm.pan_dx < -0.01 * Realm.span) {
        Realm.cx = Realm.cx + Realm.pan_dx;
        Realm.pan_dx = 0.0;
        Realm.redraw_requested = true
    };
    if (Realm.pan_dy > 0.01 * Realm.span) {
        Realm.cy = Realm.cy + Realm.pan_dy;
        Realm.pan_dy = 0.0;
        Realm.redraw_requested = true
    };
    if (Realm.pan_dy < -0.01 * Realm.span) {
        Realm.cy = Realm.cy + Realm.pan_dy;
        Realm.pan_dy = 0.0;
        Realm.redraw_requested = true
    };
    // Intensity bar at top edge — green (still) → red (vigorous tilt).
    var mag = gx;
    if (mag < 0.0) { mag = 0.0 - mag };
    var magy = gy;
    if (magy < 0.0) { magy = 0.0 - magy };
    if (magy > mag) { mag = magy };
    var magz = gz;
    if (magz < 0.0) { magz = 0.0 - magz };
    if (magz > mag) { mag = magz };
    var c = 0x07E0;             // green
    if (mag > 5000.0) { c = 0xFFE0 };    // yellow
    if (mag > 20000.0) { c = 0xFD20 };   // orange
    if (mag > 50000.0) { c = 0xF800 };   // red
    lcd_fill_rect(0, 0, 320, 10, c)
};

// === Button zoom handler ===================================================
//
// button_press is a host-registered event (urbi_event_register in main.c).
// Rising-edge fire shrinks the span by 2x (zoom in at current centre).
at (button_press?) {
    Realm.span = Realm.span * 0.5;
    Realm.redraw_requested = true
};

// === Main render loop ======================================================
//
// Clears the redraw flag, renders all levels (aborting on flag), then blocks
// until the next redraw trigger (gyro pan or button zoom).  The gyro_tick
// and button_press at-handlers run as separate coroutines between the
// cooperative yield points inside render_all.
while (true) {
    Realm.redraw_requested = false;
    Realm.render_all();
    waituntil (Realm.redraw_requested)
};
