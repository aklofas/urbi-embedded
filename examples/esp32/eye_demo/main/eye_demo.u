// === ESP32-S3-EYE blob tracker — diagnostic build for button-cycle bug ===
//
// The cycle handler (`Realm.idx = Realm.next_idx.get(Realm.idx)`) works
// end-to-end on host (test_athandler_wedge_repro + cycle_test) but
// stays stuck at idx=1 on real ESP hardware — every press logs "GREEN"
// regardless of how many times the BOOT button is pressed.  This build
// adds a log line BEFORE and AFTER each chained handler so we can see
// from the device monitor exactly which handlers fire and what
// `Realm.idx` is at each stage.
//
// To restore the production demo: revert this file to the version from
// `git show HEAD:examples/esp32/eye_demo/main/eye_demo.u`.

class Color {
    var init = function (r, g, b, tol, name) {
        this.r = r; this.g = g; this.b = b;
        this.tol = tol;
        this.name = name;
        this
    }
};

Realm.colors = List.new(
    Color.new().init(24,  6,  6, 12, "RED"),
    Color.new().init( 6, 48,  6, 16, "GREEN"),
    Color.new().init( 6,  6, 24, 12, "BLUE"));

Realm.idx      = 0;
Realm.next_idx = List.new(1, 2, 0);
Realm.blob_count = 0;

log("eye_demo (DIAG) loaded - idx=", Realm.idx);

// === BLOB SEEN — unchanged ============================================
at (blob_seen?) draw_crosshair(Realm.last_blob_x, Realm.last_blob_y);
at (blob_seen?) Realm.blob_count = Realm.blob_count + 1;

// === BUTTON CYCLE — diagnostic chain ==================================
//
// Each handler logs its own entry + idx state so the device monitor
// shows which handlers actually fire and whether Realm.idx is the
// value we expect at each stage.
//
// Expected per press:
//   h1-pre  idx=N
//   h1-post idx=(N+1)%3
//   h2-pre  idx=(N+1)%3
//   h2-post (after set_target_color)
//   h3-pre  idx=(N+1)%3 name=<expected>

at (button_pressed?) log("h1-pre idx=", Realm.idx);
at (button_pressed?) Realm.idx = Realm.next_idx.get(Realm.idx);
at (button_pressed?) log("h1-post idx=", Realm.idx);

at (button_pressed?) log("h2-pre idx=", Realm.idx);
at (button_pressed?) set_target_color(
    Realm.colors.get(Realm.idx).r,
    Realm.colors.get(Realm.idx).g,
    Realm.colors.get(Realm.idx).b,
    Realm.colors.get(Realm.idx).tol);

at (button_pressed?) log("h3 idx=", Realm.idx,
    "name=", Realm.colors.get(Realm.idx).name,
    "blobs=", Realm.blob_count);
