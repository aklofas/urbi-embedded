// Color blob tracker — ESP32-S3-EYE demo
//
// Host registers: blob_seen, button_pressed (events)
//                 draw_crosshair, set_target_color (functions)

var zones = [
    [60,  60,  180, 180],   // center
    [0,   0,   120, 120],   // top-left
    [120, 120, 240, 240]    // bottom-right
];
var current_zone = 0;
var hit_count    = 0;
var last_seen_us = 0;

var colors = [
    [31, 0,  0,  4],   // red
    [0,  63, 0,  8],   // green
    [0,  0,  31, 4]    // blue
];

at (blob_seen ?(x, y, area)) {
    if (area > 50) {
        draw_crosshair(x, y);
        last_seen_us = System.time_us();

        var z = zones[current_zone];
        if (x >= z[0] && y >= z[1] && x < z[2] && y < z[3]) {
            hit_count = hit_count + 1;
            cout << "Hit zone " << current_zone << " count=" << hit_count;
        }
    }
};

at (button_pressed) {
    current_zone = (current_zone + 1) % 3;
    var c = colors[current_zone];
    set_target_color(c[0], c[1], c[2], c[3]);
    cout << "Switched to zone=" << current_zone;
};

every (5s) {
    var elapsed_s = (System.time_us() - last_seen_us) / 1000000;
    if (elapsed_s > 5) {
        cout << "No blob seen for " << elapsed_s << "s";
    }
};
