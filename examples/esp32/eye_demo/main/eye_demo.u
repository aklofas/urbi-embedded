// SPDX-License-Identifier: BSD-3-Clause
// examples/esp32/eye_demo/main/eye_demo.u — the boot workload of the
// ESP32-S3-EYE demo.
//
// Baked into eye_demo_baked.h by the host `urbi --dump-wire-format` at
// build time and loaded into the main realm with urbi_load before the
// eval service starts.  The board verbs (draw_crosshair, set_target_chroma,
// log, heap_live, events_dropped) live on Lobby and the events (blob_seen,
// button_pressed, stats_tick) on Object, so a session sees them unqualified.
//
// blob_seen carries one Integer: x in bits 0-15, y in bits 16-31, the
// blob's pixel count from bit 32.  The camera task packs it; this script
// unpacks it.
//
// `boot` is the tag over everything installed here, stored on Object so a
// session can `boot.stop()` and take the board over.

var Object.boot = Tag.new("boot");

// Chrominance targets: a pixel matches when its dominant channel beats the
// other two by `dominance` and is at least `min_bright` (5-bit scale).
class Color {
    var init = function (dominant, dominance, min_bright, name) {
        this.dominant = dominant; this.dominance = dominance;
        this.min_bright = min_bright; this.name = name;
        this
    };
};
var Object.palette = [Color.new().init(0, 8, 12, "red"),
                      Color.new().init(1, 6, 10, "green"),
                      Color.new().init(2, 8, 10, "blue")];

var Object.Tracker = Object.new();
Tracker.count  = 0;
Tracker.target = 0;
Tracker.x = 120;
Tracker.y = 120;
Tracker.lastPress = 0;
Tracker.apply = function () {
    var c = palette[Tracker.target];
    set_target_chroma(c.dominant, c.dominance, c.min_bright);
    log("target: " + c.name)
};
Tracker.apply();

boot: at (blob_seen?(var p)) {
    Tracker.x = p.and(65535);
    Tracker.y = p.shr(16).and(65535);
    Tracker.count = Tracker.count + 1;
    draw_crosshair(Tracker.x, Tracker.y)
};

// The interrupt fires on every electrical bounce; one logical press per
// 200 ms window.
boot: at (button_pressed?) {
    var now = System.time_us();
    if (now - Tracker.lastPress > 200000) {
        Tracker.lastPress = now;
        Tracker.target = (Tracker.target + 1) % 3;
        Tracker.apply()
    }
};

// String + Integer does not concatenate; the Integers go through asString.
boot: every (2s) log("stats: count " + Tracker.count.asString() + ", target " + palette[Tracker.target].name
                     + ", live " + heap_live().asString() + " B, dropped " + events_dropped().asString());
