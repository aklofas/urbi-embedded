# sdkconfig.defaults for the eye_demo on the ESP32-S3-EYE v2.2:
# ESP32-S3-WROOM-1 N8R8 (8 MB flash, 8 MB octal PSRAM), OV2640 camera,
# ST7789 240x240 LCD on SPI2, GPIO 0 BOOT button.
# ESP-IDF seeds the build's sdkconfig from this file on the first build.

# Target SoC.
CONFIG_IDF_TARGET="esp32s3"

# 8 MB flash; the default 2 MB cannot hold the 5 MB factory partition.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Octal PSRAM at 80 MHz, as fitted on N8R8 modules.  The frame buffers
# live there.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 100 Hz tick, the rate the runtime's scheduler timing assumes.
CONFIG_FREERTOS_HZ=100

# 16 KB main task stack.  The default 3584 B is too small for runtime
# setup and session start; an overflow corrupts neighbouring heap and
# panics a later interrupt allocation.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Console, panics and bootloader output share the USB Serial/JTAG port
# with the REPL session.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Custom partition table (partitions.csv beside this file).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Heap arena for the runtime, in internal SRAM (see Kconfig.projbuild).
CONFIG_URBI_ARENA_BYTES=131072

# esp_video DVP capture device and the OV2640 driver, with the sensor's
# native 240x240 RGB565 at 25 fps so frames match the display 1:1.
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_OV2640=y
CONFIG_CAMERA_OV2640_DVP_RGB565_240X240_25FPS=y
CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_RGB565_240X240_25FPS=y

# Camera on by default; turn it off to run the display, button and
# workload on an S3 board without the sensor.
CONFIG_EYE_DEMO_ENABLE_CAMERA=y
