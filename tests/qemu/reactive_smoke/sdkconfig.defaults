# sdkconfig.defaults for the qemu smoke.  ESP-IDF seeds the build's
# sdkconfig from this file on the first build.

# Target SoC.
CONFIG_IDF_TARGET="esp32s3"

# 4 MB flash; partitions.csv holds a 1 MB factory app.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# No PSRAM: the runtime's arena is in internal SRAM, as on the board.
CONFIG_SPIRAM=n

# 100 Hz tick, the rate the runtime's scheduler timing assumes.
CONFIG_FREERTOS_HZ=100

# Custom partition table (partitions.csv beside this file).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 16 KB main task stack, as in the demo.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Heap arena for the runtime, in internal SRAM; the demo's figure.
CONFIG_URBI_ARENA_BYTES=131072
