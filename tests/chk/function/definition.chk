# Milestone: M2
# Covers: function definition syntax; OP_CLOSURE in root chunk;
#         closure values displayed as <?>; bare-function, named-function, and
#         closure-keyword rejection errors; zero-param, single-param,
#         multi-param forms.

# --- zero-param function produces a closure value
function() { 42 }
[00000001] <?>

# --- single-param function
function(x) { x + 1 }
[00000002] <?>

# --- two-param function
function(a, b) { a + b }
[00000003] <?>

# --- named function decl is rejected at v1.0 (PARSE-004); use var = function
function add(a, b) { a + b }
[00000004] !!! <stdin>:1:10: named-function declarations are not supported at v1.0; use 'var name = function(...){...}'

# --- function stored in a var (var statement yields the assigned value)
var f = function(x) { x * 2 }
[00000005] <?>

# --- bare function form rejected
function foo { 1 }
[00000006] !!! <stdin>:1:10: bare 'function name { body }' is retired at v1.0; use 'function name() { body }' (add empty parens). Per REVIVAL §14 L13

# --- closure keyword rejected
closure(x) { x }
[00000007] !!! <stdin>:1:1: the 'closure' keyword is retired at v1.0; use 'function' instead. MIGRATION TRAP: 'closure' bound 'this' lexically; 'function' binds at call site. See REVIVAL §14 L14 for 'lobby.receive' rebind pattern

# --- REPL recovers after error
42
[00000008] 42
