# Covers: a slot read through one site keeps giving the right answer
#         while the objects behind it change: a shadowing slot appears
#         on an intermediate prototype and then on the receiver, slots
#         are removed again, the prototype list grows and shrinks, a
#         watcher observes a write made through a warm site, and an
#         accessor is installed on a slot that warm read and write sites
#         already reach: a setter-only slot still reads its value, a
#         setter runs, and a write to a getter-only slot keeps the getter.
#
# Each reader is a function so the SAME site runs every time.  Every
# reader is called twice before the first change, which is what makes the
# second call one the runtime may answer from memory.

var P = Object.clone() | 0
[00000000] 0
var P.v = 1
[00000000] 1
var M = P.clone() | 0
[00000000] 0
var o = M.clone() | 0
[00000000] 0
var read = function() { o.v } | 0
[00000000] 0
read()
[00000000] 1
read()
[00000000] 1
var M.v = 2
[00000000] 2
read()
[00000000] 2
read()
[00000000] 2
var o.v = 3
[00000000] 3
read()
[00000000] 3
o.removeSlot("v") | 0
[00000000] 0
read()
[00000000] 2
M.removeSlot("v") | 0
[00000000] 0
read()
[00000000] 1
