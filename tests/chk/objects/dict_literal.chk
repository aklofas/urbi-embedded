# Wave 6 W10 — dict literal ["k" => v, ...] (v0.10.5)
# Covers: dict literal parsing + lowering to Dict.new() + repeated .set().
# Ruling: implemented — stdlib-call lowering; no new opcode.
# Audit: closes legacy F14 (dict literal gap).
# Source: legacy tests/2.x/dictionary.chk dict-literal sections.

# --- empty dict literal (use Dict.new() since [] is list) ---
var d = Dict.new(); d.length()
[00000000] 0

# --- single-pair dict literal ---
var d = ["a" => 1]; d.length()
[00000001] 1

var d = ["a" => 1]; d.get("a")
[00000002] 1

# --- two-pair dict literal ---
var d = ["x" => 10, "y" => 20]; d.get("x")
[00000003] 10

var d = ["x" => 10, "y" => 20]; d.get("y")
[00000004] 20

# --- dict literal with expression values ---
var n = 5; var d = ["val" => n * 2]; d.get("val")
[00000005] 10

# --- dict is mutable after literal creation ---
var d = ["a" => 1]; d.set("a", 99); d.get("a")
[00000006] 99

# --- dict literal: has() membership ---
var d = ["hello" => 42]; d.has("hello")
[00000007] true

var d = ["hello" => 42]; d.has("world")
[00000008] false
