# Milestone: M6 Wave 2 (Phase 2 follow-up)
# Covers: T41 install-time arity validation for `get`/`set` parse sugar.
#
# Pre-fix: a wrong-arity getter / setter would compile cleanly and
# install successfully; the dispatch-time invocation later read from
# uninitialized register slots → SIGSEGV.  Post-fix: rejected at
# Object.setProperty install time and an arity error surfaces from the
# OP_CALL native arm.
#
# As of v0.11.4 a native-method UEXEC_THROW is no longer a fatal HALT:
# urbi_raise_arity builds a typed ArityError instance and the OP_CALL arm
# deposits it as a catchable throw.  An *uncaught* throw at top level now
# unwinds the strand and the REPL renders the (degraded) uncaught result
# as `nil`.
#
# NOTE(follow-up task): the uncaught-diagnostic printer does not yet read the
# thrown instance's `message` slot, so an uncaught arity error renders as bare
# `nil` rather than a frame line.  This fixture is pinned to that real (still
# degraded) output; revisit when the uncaught printer is taught to surface the
# instance message.

var Foo = Object.clone(); Foo.get x(a, b) { a + b }; Foo.x
[00000000] nil

var Bar = Object.clone(); Bar.set y() { 42 }; Bar.y = 1
[00000001] nil

var Baz = Object.clone(); Baz.set z(a, b) { a + b }; Baz.z = 1
[00000002] nil
