# Milestone: M3
# Covers: a tag stop delivered inside a `|`-chain unwinds the current
#         strand through the cleanup stack, executing finally bodies and
#         popping TAG_SCOPE entries in order.
# matrix-row: tag-stop
#
# The links that write `log` are blocks: an assignment cannot be the
# right operand of a `|` whose left is not an assignment, so the legacy
# spelling `log = log + "a" | t.stop() | log = log + "c"` does not parse.
# The control runs the same chain under a tag nobody stops and sees every
# link and the finally; the stopped chain sees the link before the stop
# and the finally, never the link after.
var log = ""
var t = Tag.new()
var u = Tag.new()
u: { try { { log = log + "a" } | { log = log + "b" } | { log = log + "c" } } finally { log = log + "F" } }; log
log = ""
t: { try { { log = log + "a" } | t.stop() | { log = log + "c" } } finally { log = log + "F" } }; log
log
[00000001] ""
[00000002] <Tag>
[00000003] <Tag>
[00000004] "abcF"
[00000005] ""
[00000006] "aF"
[00000007] "aF"
