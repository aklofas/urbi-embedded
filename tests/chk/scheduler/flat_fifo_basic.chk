# Milestone: M3
# Covers: two strands enqueued in FIFO order; scheduler dispatches them
#         in order A-then-B; both run to completion.
# matrix-row: scheduler-fifo
#
# Each `,` arm is spawned onto the ready queue in source order and the
# chunk goes on with its last arm, so `main` prints first; the two
# spawned strands then run in the order they were enqueued.  The last
# step finds nothing left: both ran to completion.
## timeout: 30
## host: run { echo("A") }, { echo("B") }, echo("main")
## host: step 1000
## host: live-work
[00000000] *** main
[00000000] *** A
[00000000] *** B
[00000000] nil
[00000000] step: QUIESCENT
[00000000] live-work: false
