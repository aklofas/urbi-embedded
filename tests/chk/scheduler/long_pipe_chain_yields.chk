# Milestone: M3
# Covers: a long `|`-chain whose strand runs out of instruction budget
#         comes back from the step RUNNING, unfinished, and resumes where
#         it stopped on the next step until the chain completes.
# matrix-row: scheduler-pipe
#
# The chain runs in an `at` body so that it starts inside a `step` the
# fixture sizes, as budget_step_exhausted.chk does.  Between the two
# steps only `live-work` is asked: a `run` would pump the unfinished
# strand itself.  An assignment cannot be the right operand of a `|`
# whose left is not an assignment, so the last link is a block.
## timeout: 30
## host: run var x = 0
## host: run var done = 0
## host: run at (x > 0) { var i = 0 | while (i < 20000) { i = i + 1 } | { done = i } }
## host: set-global x 1
## host: step 1
## host: live-work
## host: step 1000000
## host: run done
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] set-global: ok
[00000000] step: RUNNING
[00000000] live-work: true
[00000000] step: QUIESCENT
[00000000] 20000
