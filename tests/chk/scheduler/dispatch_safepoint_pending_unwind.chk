# Milestone: M3 / activated v0.10.14
# Covers: a throw inside a while-loop body is caught by an outer try/catch;
#         the unwind walker absorbs the UEXEC_THROW state and resumes after
#         the catch block.  The original stub claimed safepoint-pending_unwind
#         path was needed (T39 tunables), but OP_THROW directly calls
#         urbi_unwind() — the behavioral outcome (catch absorbs exception,
#         post-catch value is correct) is observable from pure urbiscript.
#         The safepoint pending_unwind branch (for externally-deposited
#         unwinds) is covered by tests/unit/test_dispatch_loop.c.

var caught = 0; try { var i = 0; while (i < 1) { i = i + 1; throw 99 } } catch (e) { caught = e }; caught
[00000000] 99
