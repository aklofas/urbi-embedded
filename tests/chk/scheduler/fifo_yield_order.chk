# Milestone: M3
# Covers: two strands enqueued FIFO; after a soft yield the first strand
#         goes to the tail and the second strand runs next (FIFO ordering
#         across yield boundaries).
# matrix-row: scheduler-fifo
#
# The `;` between two statements is the soft yield: with another strand
# ready, the strand goes back on the ready queue behind every strand
# already there.  Three `,` arms each print twice across a `;`, so FIFO
# order is the interleaving A1 B1 C1 A2 B2 C2; a strand that kept running
# past its yield would print A1 A2 first.  The script-side twin of
# tests/rt/test_sched.c::yield_round_robins_in_fifo_order.
## timeout: 30
## host: run { echo("A1"); echo("A2") }, { echo("B1"); echo("B2") }, { echo("C1"); echo("C2") }, 0
## host: step 1000
## host: live-work
[00000000] *** A1
[00000000] *** B1
[00000000] *** C1
[00000000] *** A2
[00000000] *** B2
[00000000] *** C2
[00000000] 0
[00000000] step: QUIESCENT
[00000000] live-work: false
