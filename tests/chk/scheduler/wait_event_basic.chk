# Milestone: M3
# Covers: a strand calls waituntil(event?); it blocks until the event fires;
#         when the event is emitted the strand resumes (USTRAND_REASON_EVENT).
#
# Activated: v0.10.7 W7 — waituntil(e?) + Event.new() shipped (M5 reactive
# runtime + v0.6.1 stdlib).
# Old label: M5
#
# The counter is read back as a value rather than echoed: `echo` is not a
# bare name in the single-session chk driver.

var e = Event.new()
var t = Tag.new()
var fired = 0
t: { waituntil(e?) | fired = 1 }
e!
fired
[00000000] <event>
[00000000] <Tag>
[00000000] 0
[00000000] nil
[00000000] nil
[00000001] 1
