# Milestone: M3
# Covers: a strand calls waituntil(event?); it blocks until the event fires;
#         when the event is emitted the strand resumes (USTRAND_REASON_EVENT).
#
# Activated: v0.10.7 W7 — waituntil(e?) + Event.new() shipped (M5 reactive
# runtime + v0.6.1 stdlib).
# Old label: M5
#
# Note: Realm.fired used as the observable output (bare echo not available
# as a top-level name in single-session chk driver; use Lobby.echo).

var e = Event.new()
var t = Tag.new()
var fired = 0
t: { waituntil(e?) | Realm.fired = 1 }
e!
Realm.fired
[00000000] <event>
[00000000] <Tag>
[00000000] 0
[00000000] nil
[00000000] nil
[00000001] 1
