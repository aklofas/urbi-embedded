# Milestone: M3 (activated v0.14.0-refoundation)
# Covers: a strand cut off by an exhausted step budget RESUMES where it
#         stopped; it does not restart.  Three one-instruction steps each
#         come back RUNNING, and the loop counter ends at exactly 3000 --
#         a restart would overshoot, a lost resume would fall short.  That
#         is the soft-yield-and-resume contract, observed across turns
#         rather than inside one.
#
#         Sibling of budget_step_exhausted.chk, which pins the step RESULT
#         and the strand's survival; this one pins the arithmetic that
#         proves the strand is the same strand.
#
#         The `,` interleaving the original fixture wanted -- catching a
#         second strand running in the gap -- is still out of reach from a
#         golden-diff fixture, and still does not justify freezing a
#         per-strand budget accessor into the API.
# matrix-row: scheduler-budget

## host: run var x = 0
## host: run var ticks = 0
## host: run at (x > 0) { var i = 0; while (i < 3000) { i = i + 1; ticks = ticks + 1 } }
## host: set-global x 1
## host: step 1
## host: step 1
## host: step 1
## host: step 1000000
## host: run ticks
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] set-global: ok
[00000000] step: RUNNING
[00000000] step: RUNNING
[00000000] step: RUNNING
[00000000] step: QUIESCENT
[00000000] 3000
