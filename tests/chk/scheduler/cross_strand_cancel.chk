# Milestone: M3
# Covers: tag.stop() issued from one strand cancels a different strand that
#         is currently in WAITING state or mid-execution; the cancelled strand
#         does not produce further output.
# matrix-row: scheduler-strand
#
# Host-driver form: each declaration is its own `run`, so the `,` groups
# that follow can all see `t`.  Two strands are under `t`: one WAITING in
# a sleep, and one busy in a loop whose `;` lets a sibling run after each
# round.  A third `,` arm stops `t`.  The busy strand is cancelled after
# its first round (n is 1, not 1000000) and neither strand ever logs; a
# control sleeper under a tag nobody stops does log when the clock moves.
#
# The loop body carries a `;` on purpose: an unbudgeted pump gives a
# slice no limit, so a loop with no `;` in it would run to its end before
# the stopping arm got a turn (docs/internals/runtime.md, the scheduler).
## timeout: 30
## host: run var t = Tag.new()
## host: run var c = Tag.new()
## host: run var log = ""
## host: run var n = 0
## host: run c: { sleep(1s); log = log + "C" }, 0
## host: run t: { sleep(1s); log = log + "W" }, 0
## host: run t: { while (n < 1000000) { n = n + 1; 0 }; log = log + "B" }, { t.stop() }, 0
## host: run n
## host: step 1000
## host: advance-clock 2000
## host: step 1000
## host: run log
## host: live-work
[00000000] <Tag>
[00000000] <Tag>
[00000000] ""
[00000000] 0
[00000000] 0
[00000000] 0
[00000000] 0
[00000000] 1
[00000000] step: WAKE_AT
[00000000] step: QUIESCENT
[00000000] "C"
[00000000] live-work: false
