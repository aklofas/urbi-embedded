# Milestone: M3
# Covers: a strand sleeping on the sleep queue is woken (its wake_us passes)
#         while another strand is currently running; urbi_step delivers the
#         wakeup at the next scheduler turn after the running strand yields
#         -- it does not wait for the running strand to complete.
# matrix-row: scheduler-wake
#
# Host-driver form: the shared `log` is declared in its own `run`.  The
# busy strand is an `at` body, so it starts inside a budgeted `step`
# (as budget_step_exhausted.chk does): it logs `r`, then spends far more
# than one slice in a loop.  The clock passes the sleeper's deadline
# while the busy strand is mid-loop; the sleeper's `S` lands between the
# busy strand's `r` and its closing `R`.
## timeout: 30
## host: run var x = 0
## host: run var log = ""
## host: run { sleep(10ms); log = log + "S" }, 0
## host: run at (x > 0) { log = log + "r"; var i = 0; while (i < 20000) { i = i + 1 }; log = log + "R" }
## host: set-global x 1
## host: step 1
## host: advance-clock 10
## host: step 1
## host: step 1
## host: step 1000000
## host: run log
[00000000] 0
[00000000] ""
[00000000] 0
[00000000] nil
[00000000] set-global: ok
[00000000] step: RUNNING
[00000000] step: RUNNING
[00000000] step: RUNNING
[00000000] step: QUIESCENT
[00000000] "rSR"
