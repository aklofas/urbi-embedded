# Milestone: v0.10.12-cat-e-activation
# Covers: cross-spec composition: event subscriber writes to a slot that has
#         a slot-change watcher; chain: e! -> slot write -> slot-change sub fires.
#         Tests that event-driven slot writes trigger downstream slot-change
#         watchers (spec cross-spec §2.1 chaining rule).
# matrix-row: reactive-event
#
# Activation history: Cat. E re-audit D2 ratified at v0.10.12.  The original
# 'blocked: chain does not propagate' label was unsubstantiated by C-level
# evidence (c_event_emit_async is non-allocating + body-strand-safe + unit-
# tested via test_event_emit_async.c).  Activated empirically via Realm.x = v
# capture (the v0.10.10 W3 pattern).
#
# Uses Realm slots for both the trigger slot (Realm.x) and the counter
# (Realm.chain_fired) to avoid nondeterministic <object 0x...> addresses.
# Realm.x is pre-initialized to 0 before the slot-change watcher is installed
# so the first slot-change event fires only on the write inside the at(e?) body,
# not on watcher install.

var Realm.chain_fired = 0
[00000000] 0

var Realm.x = 0
[00000001] 0

var e = Event.new()
[00000002] <event>

at (Realm.x.changed?) Realm.chain_fired = Realm.chain_fired + 1
[00000003] nil

at (e?) Realm.x = 1
[00000004] nil

e!
[00000005] nil

Realm.chain_fired
[00000006] 1
