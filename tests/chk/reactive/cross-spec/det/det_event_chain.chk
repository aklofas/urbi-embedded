# Milestone: v0.10.12-cat-e-activation
# Covers: chained event dispatch correctness — 4-deep chain fires in
#         registration order; D-cross-1 rule minimal correctness test.
#         Each subscriber in the chain emits the next event; the sequence
#         accumulator Realm.seq must read "0123" after one chain traversal.
# matrix-row: reactive-event
#
# Activation history: Cat. E re-audit D2 ratified at v0.10.12.  The original
# 'blocked: cross-spec event chain gap' label was unsubstantiated by C-level
# evidence (c_event_emit_async is non-allocating + body-strand-safe + unit-
# tested via test_event_emit_async.c).  Activated empirically via Realm.seq
# accumulator pattern.
#
# Minimal correctness test (single chain traversal).  The full 100x3-preset
# determinism guarantee additionally pins on T39 chk-runner tunables-extension
# (design-risks v0.10.7-G) which has not shipped.  Full multi-iteration variant
# stays deferred until T39 resolves.
#
# Body separator | (atomic pipe) used to sequence the slot write and the next
# emit within each subscriber body without spawning a parallel strand.

var Realm.seq = ""
[00000000] ""

var e0 = Event.new()
[00000001] <event>

var e1 = Event.new()
[00000002] <event>

var e2 = Event.new()
[00000003] <event>

var e3 = Event.new()
[00000004] <event>

at (e0?) { Realm.seq = Realm.seq + "0" | e1! }
[00000005] nil

at (e1?) { Realm.seq = Realm.seq + "1" | e2! }
[00000006] nil

at (e2?) { Realm.seq = Realm.seq + "2" | e3! }
[00000007] nil

at (e3?) Realm.seq = Realm.seq + "3"
[00000008] nil

e0!
[00000009] nil

Realm.seq
[00000010] "0123"
