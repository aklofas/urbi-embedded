# Covers: whenever (cond) body else else_body — the else arm fires once on
#         the falling edge, and only after the body has run at least once.
#
# `whenever` is a reactive loop: the body re-fires while the condition
# holds, so this body walks the condition down (10 -> 5) and runs five
# times; the else arm then fires exactly once for the single true->false
# transition.  The same guard that stops `at`'s onleave from firing at
# install time stops the else arm from firing before any body has run.
#
# HISTORY.  The pre-activation form pinned `on_count == 2` for a body that
# never touched its condition; the 2 was a count of old-core safepoints,
# and under the ratified loop semantics that program does not terminate.
# See reactive/at/whenever_level.chk.

var x = 0
var on_count = 0
var off_count = 0
whenever (x > 5) { on_count = on_count + 1; x = x - 1 } else { off_count = off_count + 1 }
var trigger = function() { x = 10 }; trigger()
on_count
off_count
[00000000] 0
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] 10
[00000000] 5
[00000000] 1
