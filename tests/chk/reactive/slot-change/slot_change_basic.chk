# Covers: at (obj.x.changed?) — one subscriber, one write, one fire.
# matrix-row: reactive-slot-change
#
# `obj.x = 0` comes first, on the declaration line, because declaring a
# slot is not changing it:
# reactive/slot-change/slot_change_no_install_emit.chk pins that rule, and
# the pre-activation draft here (written before it) expected the declaring
# write to fire.

var obj = Object.new(); obj.x = 0
var fired = 0
at (obj.x.changed?) fired = fired + 1
obj.x = 42
fired
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] 42
[00000000] 1
