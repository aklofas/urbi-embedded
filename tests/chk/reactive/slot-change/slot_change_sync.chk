# Covers: at sync (obj.x.changed?) — the subscriber body runs inline, so
#         the value it reads is the one just written and it has finished
#         before the next statement on the same line.
# matrix-row: reactive-slot-change
#
# The canonical spelling is the `at sync (...)` keyword phrase; the M5-era
# draft used a `.sync` dot-syntax that the language does not have.
#
# `obj.x = 0` on the declaration line: declaring a slot is not changing it
# (see slot_change_no_install_emit.chk).

var obj = Object.new(); obj.x = 0
var seen = 0
at sync (obj.x.changed?) seen = obj.x
obj.x = 7; seen
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] 7
