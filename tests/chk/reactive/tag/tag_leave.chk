# Covers: at (mytag.leave?) — the tag's leave event fires when a scope
#         prefixed with that tag is left (OP_POP_TAG).
# matrix-row: tag-scope-events
#
# Like `t.enter`, `t.leave` is a property whose getter allocates the event
# on first ask.
#
# NOT covered here: the ordering between a tier-1 `onleave` clause on the
# tag PREFIX and this tier-2 event.  `t: { ... } onleave { ... }` does not
# parse — tag-prefix onleave is a frontend v1.x item
# (src/parse/uparse_react.c, AST_TAG_PREFIX.onleave is always NULL) — so
# there is no second edge to order against yet.  The `at (cond) body
# onleave handler` form, which is a different construct, is covered by
# reactive/at/at_onleave.chk.

var t = Tag.new("scope")
var log = ""
at (t.leave?) log = log + "out"
t: { 1 }
log
[00000000] <Tag: scope>
[00000000] ""
[00000000] nil
[00000000] 1
[00000000] "out"
