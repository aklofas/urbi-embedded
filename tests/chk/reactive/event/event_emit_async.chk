# Covers: e! — an emit fires every `at (e?)` subscriber, in the order they
#         subscribed.
# matrix-row: reactive-event
#
# The bodies run on spawned strands, so the accumulator is only settled
# once the emitting line's pump has drained them; the read is therefore on
# its own line.

var e = Event.new()
var log = ""
at (e?) log = log + "A"
at (e?) log = log + "B"
e!
log
[00000000] <event>
[00000000] ""
[00000000] nil
[00000000] nil
[00000000] nil
[00000000] "AB"
