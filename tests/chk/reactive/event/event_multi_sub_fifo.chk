# Covers: three subscribers on one event, two emissions: every subscriber
#         runs once per emission, and the subscriber list is walked in
#         registration order both times.
# matrix-row: reactive-event

var e = Event.new()
var seq = ""
at (e?) seq = seq + "A"
at (e?) seq = seq + "B"
at (e?) seq = seq + "C"
e!; e!
seq
[00000000] <event>
[00000000] ""
[00000000] nil
[00000000] nil
[00000000] nil
[00000000] nil
[00000000] "ABCABC"
