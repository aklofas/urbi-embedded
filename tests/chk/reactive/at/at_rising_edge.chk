# Milestone: M5
# Covers: at (cond) body — rising-edge fire; body runs once when cond
#         transitions false→true; does not re-fire on same-direction writes.
#
# Activated 2026-05-05 as part of cond-closure unstub.
# Cond evaluation goes through urbi_run_closure_on_scratch
# (src/watcher/uwatcher_scratch.c); body fires through the M5-baseline
# spawn_body_coroutine path.  The REPL drains spawned body strands with
# urbi_step after each uvm_run so the counter is updated before the next
# line executes.
#
# The nested function pattern (trigger()) is required: watcher_eval_dirty
# fires at non-top-frame OP_RET safepoints, which a nested call provides.
# A bare top-level assignment does not trigger the safepoint path.

var x = 0;
var fired = 0;
at (Realm.x > 5) Realm.fired = Realm.fired + 1;
var trigger = function() { Realm.x = 10 }; trigger();
Realm.fired
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] 10
[00000000] 1
