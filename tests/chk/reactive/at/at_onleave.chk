# Milestone: M5 (v0.5.2)
# Covers: at (cond) body onleave handler — falling-edge fire of onleave after
#         body has fired at least once.  The URBI_WATCHER_BODY_FIRED_SINCE_ONLEAVE
#         flag guards onleave so it never fires without a preceding body fire.
#
# The integer counter pattern (n += 1 on the rise, n += 10 on the fall)
# matches at_rising_edge.chk and tells the two edges apart in one value.

var x = 0;
var n = 0;
at (x > 5) n = n + 1 onleave n = n + 10;
var trigger_up = function() { x = 10 }; trigger_up();
var trigger_down = function() { x = 0 }; trigger_down();
n
[00000000] 0
[00000014] 0
[00000014] nil
[00000014] 10
[00000014] 0
[00000014] 11
