# Milestone: M5
# Covers: whenever (cond) body — level-trigger semantics; body fires on every
#         eval pass where condition is truthy, not just on rising edge.
#
# Activated 2026-05-05 as part of cond-closure unstub.
# Uses two separate trigger functions so there are two safepoints (one per
# non-top-frame OP_RET) while Realm.x > 5 is truthy.  whenever fires at each
# safepoint visit where cond is truthy (fired = 3); at would fire only on the
# false→true transition (fired = 1).  Confirms UWATCHER_WHENEVER level-trigger
# path in watcher_eval_dirty (uwatcher_eval.c).

var x = 0;
var fired = 0;
whenever (Realm.x > 5) Realm.fired = Realm.fired + 1;
var t1 = function() { Realm.x = 10 }; t1();
var t2 = function() { Realm.x = 11 }; t2();
Realm.fired
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] 10
[00000000] 11
[00000000] 3
