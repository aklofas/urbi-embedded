# Covers: tier-2 tag enter/leave event ordering.  `at sync (t.enter?)`
#         runs before the scope body; `at sync (t.leave?)` runs after it,
#         while the scope is still being left.  Two successive entries
#         produce EinLEinL, in that order, every run.
# matrix-row: tag-scope-events
#
# The SYNC form is what makes "before" and "after" mean anything here:
# entering a scope fires the tag's enter event synchronously on the
# crossing strand, so an at-sync subscriber's body runs inside OP_PUSH_TAG.
# A plain `at (t.enter?)` gets a spawned strand like every other event
# subscriber, and its body lands after the installing strand next yields
# -- "inELinEL" for the same program, which is deterministic but says
# nothing about scope boundaries.
#
# `t.enter` and `t.leave` are properties whose getters allocate the event
# on first ask, so a tag nobody subscribes to pays nothing for either.

var t = Tag.new("t")
var log = ""
at sync (t.enter?) log = log + "E"
at sync (t.leave?) log = log + "L"
t: { log = log + "in" }
t: { log = log + "in" }
log
[00000000] <Tag: t>
[00000000] ""
[00000000] nil
[00000000] nil
[00000000] "Ein"
[00000000] "EinLEin"
[00000000] "EinLEinL"
