# Covers: operands are read left to right and a closure in the right
#         operand that rebinds the left operand's local does not change
#         the value already read -- arithmetic, comparison, and the
#         receiver of a slot assignment.

var g = function() { var x = 1; var bump = function() { x = 2; 10 }; x + bump() }; g()
[00000000] 11

var h = function() { var x = 1; var bump = function() { x = 5; 3 }; x < bump() }; h()
[00000001] true

var k = function() { var o = Object.new(); o.v = 0; var o1 = o; var swap = function() { o = Object.new(); 9 }; o.v = swap(); o1.v }; k()
[00000002] 9
