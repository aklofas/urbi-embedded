# Milestone: v0.13.1 (rebaselined v0.13.5: numeric zero now falsy)
# Covers: unary `!` — logical negation via the OP_TEST/OP_LOADBOOL idiom
#         (refactor-3 FE-03/B7: previously lowered to arithmetic OP_NEG;
#         `!5` evaluated to -5). Truthiness follows uvalue_truthy: numeric
#         zero is falsy (legacy-conformant), so `!0` is true; nil is falsy.

!true
[00000000] false

!false
[00000001] true

!5
[00000002] false

!0
[00000003] true

!nil
[00000004] true

!!5
[00000005] true

var done = false; var n = 0; while (!done) { n = n + 1; if (n >= 3) { done = true } }; n
[00000006] 3

# Local-non-clobber regression pin: `!a` must not overwrite the local `a`
# in place (guards the rd = src_reg choice against a future emit_ident_arm
# copy-elision).
var a = 5; var b = !a; a
[00000007] 5

# String truthiness: interned string refs are truthy per uvalue_truthy.
!"str"
[00000008] false

# Composed form: `!` over a comparison result.
var p = 1; var q = 2; !(p == q)
[00000009] true
