# Covers: two finally bodies on one strand, back to back.  The first
#         raises and catches INSIDE its own body and then completes
#         normally; the second sleeps.  Neither disturbs the other, and
#         the sleeping one resumes and delivers its return.
#
# The old core had a per-strand "cleanup absorbed" flag, and this fixture
# existed because a stale flag from f1 could mask f2's escalation: a
# sleeping finally was a fatal there, and f1's absorbed throw could make
# f2's park look like an absorb instead.  The re-founded runtime has
# neither half of that.  A finally is an ordinary continuation of its
# frame, so f1's inner try/catch is just a try/catch and f2's sleep is
# just a sleep -- no flag, nothing to go stale, nothing to mask.
#
# What is still worth pinning, and is pinned here: f1 returns 1 with its
# in-body catch having run (a == 5); f2's sleeping finally parks the whole
# line mid-way, so `done` is still 0 and a step reports a pending
# deadline; and once the clock passes it the line finishes, delivering
# f2's return and setting done.
## timeout: 30
## host: run Realm.a = 0
## host: run Realm.r1 = 0
## host: run Realm.done = 0
## host: run var f1 = function() { try { return 1 } finally { try { throw(5) } catch (var e) { Realm.a = e } } }
## host: run var f2 = function() { try { return 2 } finally { sleep(10ms) } }
## host: run Realm.r1 = Realm.f1(); Realm.r2 = Realm.f2(); Realm.done = 1
## host: run Realm.r1
## host: run Realm.a
## host: run Realm.done
## host: step 1000
## host: advance-clock 20
## host: step 1000
## host: run Realm.done
## host: run Realm.r2
[00000000] 0
[00000000] 0
[00000000] 0
[00000000] <?>
[00000000] <?>
[00000000] nil
[00000000] 1
[00000000] 5
[00000000] 0
[00000000] step: WAKE_AT
[00000000] step: QUIESCENT
[00000000] 1
[00000000] 2
