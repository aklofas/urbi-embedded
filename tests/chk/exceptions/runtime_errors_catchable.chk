# Covers: arith/compare/call type errors are catchable and run finally,
# matching the legacy error model (typed throws, not process fatals).

var r1 = "no"; try { nil + 1 } catch (var e) { r1 = "caught" }; r1
[00000001] "caught"
var r2 = "no"; try { "a" < "b" } catch (var e) { r2 = "caught" }; r2
[00000002] "caught"
var f = 0; try { try { nil + 1 } finally { f = 9 } } catch (var e) { }; f
[00000003] 9
var r3 = "no"; var g = function (x) { x }; try { g(1, 2, 3) } catch (var e) { r3 = "caught" }; r3
[00000004] "caught"
var r4 = "no"; try { (5)() } catch (var e) { r4 = "caught" }; r4
[00000005] "caught"
var q = "no"; try { try { 1 } finally { nil + 1 } } catch (var e) { q = "caught" }; q
[00000006] "caught"

# --- string-operand arithmetic/comparison are TypeError, not fatal ---
# Each expression type-errors (glyph-style message from T14); all are catchable.
var r7 = "no"; try { "a" - 1 } catch (var e) { r7 = e.isA(TypeError) }; r7
[00000007] true
var r8 = "no"; try { nil * 2 } catch (var e) { r8 = e.isA(TypeError) }; r8
[00000008] true
# "x" / 2 type-errors on the string operand before any div-zero check
var r9 = "no"; try { "x" / 2 } catch (var e) { r9 = e.isA(TypeError) }; r9
[00000009] true
var r10 = "no"; try { 5 <= "z" } catch (var e) { r10 = e.isA(TypeError) }; r10
[00000010] true
var r11 = "no"; try { -"nope" } catch (var e) { r11 = e.isA(TypeError) }; r11
[00000011] true

# --- message-text pins for the T14 glyph style (regression guard) ---
# Binary '-' message carries the '-' glyph, not an opcode mnemonic.
var m1 = ""; try { "a" - 1 } catch (var e) { m1 = e.message }; m1.indexOf("TypeError: '-' operands must be Integer or Float") >= 0
[00000012] true
# Unary '-' message carries the unary '-' glyph phrase.
var m2 = ""; try { -"nope" } catch (var e) { m2 = e.message }; m2.indexOf("TypeError: unary '-' operand must be Integer or Float") >= 0
[00000013] true
