# Wave 6 W5 — try-catch-else (v0.10.5)
# Covers: `try { } catch (e) { } else { }` — else runs when no exception thrown;
#         catch runs when exception thrown (else does not run);
#         else body executes after the try body completes normally.
# Ruling: implemented — else emitted inline on the normal-exit path after TRY_END.
# Source: legacy F6; urbiscript SDK 2.0 §17.x exception syntax

# --- else runs when no exception is thrown ---
var r = 0; try { r = 1 } catch (var e) { r = 2 } else { r = 3 }; r
[00000001] 3

# --- catch runs when exception thrown (not else) ---
var r = 0; try { throw(1) } catch (var e) { r = 2 } else { r = 3 }; r
[00000002] 2

# --- else sees variables set in try body ---
var r = 0; try { r = 10 } catch (var e) { r = 99 } else { r = r + 5 }; r
[00000003] 15

# --- else side effect does not run on throw ---
var side = 0; try { throw(1) } catch (var e) { side = 0 } else { side = 1 }; side
[00000004] 0

# --- else side effect runs on no-throw ---
var side = 0; try { 1 } catch (var e) { side = 99 } else { side = 1 }; side
[00000005] 1

# --- else with catch (e) (no var keyword) also works ---
var r = 0; try { r = 7 } catch (e) { r = 0 } else { r = r + 1 }; r
[00000006] 8

# --- try-catch-else expression value is the try body value (else is side-effect only) ---
# When no exception: the whole expression evaluates to the try body value (1),
# not the else body value (2). else runs for side effects only.
var r = try { 1 } catch (var e) { 9 } else { 2 }; r
[00000007] 1
