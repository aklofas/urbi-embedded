# Milestone: v0.13.5 (LANG4-10)
# Covers: var x; — declaration without initializer; initializes to nil.
# Note: the reference initializes to void; we deliberately have no void
# model — the nil-init decision is ledgered in REVIVAL.md §14.

# --- uninitialized var reads as nil
var x; x
[00000000] nil

# --- uninitialized var can be assigned after declaration
var y; y = 5; y
[00000001] 5

# --- multiple uninitialized vars
var a; var b; a = 1; b = 2; a + b
[00000002] 3
