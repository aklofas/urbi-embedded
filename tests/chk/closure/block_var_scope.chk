# Milestone: v0.13.5
# Covers: a `var` declared inside a block at chunk top is scoped to that
#         block and does not clobber an outer chunk-top (realm-global)
#         binding of the same name; bare chunk-top vars keep realm-slot
#         persistence. Mirrors urbi's block-scoped var semantics (SDK 2.0
#         chapter 17).
# matrix-row: block-scoped-var
#
# Emit shape: emit_var_decl_arm routes the chunk-top realm-global install
# only for a BARE chunk-top var (fs->parent == NULL && fs->nblocks == 0);
# block-nested chunk-top vars fall through to the frame-local branch.
# Activation was held behind the try-body register-seam fix (design-risks
# v0.13.5-B: a frame-local var inside a while-in-try was clobbered by the
# condition's result temp, raising a TypeError that masked the thrown
# value) — fixed in this tag; see
# tests/chk/control_transfer/try_body_hidden_local_collision.chk.

# --- 1. outer chunk-top var is unchanged after a shadowing block var
var x = 1; { var x = 2; }; x
[00000000] 1

# --- 2. nested blocks each get their own scope; the outer stays 1
var y = 1; { var y = 2; { var y = 3; }; }; y
[00000001] 1

# --- 3. block var with no initializer does not clobber the outer binding
var z = 1; { var z; }; z
[00000002] 1

# --- 4. reading the outer chunk-top var from inside a block still works
var w = 5; { w }
[00000003] 5

# --- 5. assigning (no `var`) inside a block writes through to the outer var
var v = 1; { v = 2; }; v
[00000004] 2

# --- 6. a closure inside a block captures the block-local var
var g = nil; { var q = 7; g = function () { return q }; }; g()
[00000005] 7
