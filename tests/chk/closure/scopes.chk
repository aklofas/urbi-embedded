# Milestone: v0.10.11-channel-and-isA
# Covers: closure capture from definition scope, not call scope; 'var Object.f'
#         slot assignment on a prototype; lookup of i inside f() resolves to
#         outer global i, not inner block-local i.
# matrix-row: object-slot-install
#
# Legacy tests/2.x/scopes.chk expected `lookup failed: i` from the call,
# because a legacy top-level `var` was a Lobby slot that a function
# installed on Object could not see.  Here a chunk-top `var` is a realm
# global, so the body's `i` is the outer one: the call adds to it, and a
# block-local `i` at the call site is neither read nor written.  Compound
# assignment is not parsed, so the body spells `i += x` out.  A closure
# value renders as `<?>`.
var i = 41
var Object.f = function(x) { i = i + x }
{ var i = 0; Object.f(1) }
i
{ var i = 0; Object.f(1); i }
i
[00000001] 41
[00000002] <?>
[00000003] 42
[00000004] 42
[00000005] 0
[00000006] 43
