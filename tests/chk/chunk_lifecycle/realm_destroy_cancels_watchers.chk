# Milestone: v0.9.4 (visit; original draft M3)
# Covers: destroying a Realm cancels all periodics/watchers registered in
#         that Realm; pending bodies do not fire after destruction.
#
# The action under test is urbi_realm_free, a C entry with no urbiscript
# surface, so the fixture runs on the host driver and frees the realm with
# `## host: free-realm`.  In realm `r` an `at` and an `every` are armed
# and both are first shown firing.  Then `x` is written so that the
# watcher's condition rises again -- and the realm is freed before any
# step can serve that edge.  No body fires after the free, the periodic
# never ticks again, and nothing is left as live work.  The C twin of the
# timer half is tests/rt/test_sched.c::freeing_a_realm_drops_its_timers.
## timeout: 30
## host: realm r
## host: run var x = 0
## host: run at (x > 0) echo("at fired")
## host: run every(10ms) { echo("tick") }
## host: advance-clock 10
## host: step 1000
## host: set-global x 1
## host: step 1000
## host: set-global x 0
## host: step 1000
## host: set-global x 2
## host: free-realm r
## host: step 1000
## host: advance-clock 100
## host: step 1000
## host: live-work
## host: run 1 + 1
[00000000] 0
[00000000] nil
[00000000] nil
[00000000] *** tick
[00000000] step: WAKE_AT
[00000000] set-global: ok
[00000000] *** at fired
[00000000] step: WAKE_AT
[00000000] set-global: ok
[00000000] step: WAKE_AT
[00000000] set-global: ok
[00000000] step: QUIESCENT
[00000000] step: QUIESCENT
[00000000] live-work: false
[00000000] 2
