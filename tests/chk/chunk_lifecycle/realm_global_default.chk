# Milestone: M3
# Covers: passing NULL Realm to urbi_run_chunk reuses the global default Realm;
#         consecutive chunks in the same slot see shared bindings.
#
# Driven by the chk-host-driver (## host: directives): the reserved realm name
# "default" maps to the NULL/global realm.  Two consecutive `run` chunks under
# the default realm share bindings — the second chunk reads the binding the
# first installed, demonstrating the NULL->global-realm coercion.
#
# chunk 1: bind x = 42 in the global realm ; chunk 2: read x back.
## host: realm default
## host: run var x = 42
## host: run x
[00000001] 42
[00000002] 42
