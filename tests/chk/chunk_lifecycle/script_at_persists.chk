# Milestone: M3
# Covers: at(cond) watcher persists across multiple condition checks; the
#         watcher body fires when the condition transitions false->true.
#
# Activated: v0.10.7 W7 — at(cond) watcher shipped (M5 reactive runtime).
# Old label: M5
#
# Note: the trigger() function pattern is required because urbi_vm_watcher_eval_dirty
# fires at non-top-frame OP_RET safepoints; a bare top-level assignment does
# not trigger the safepoint path.  Realm vars used instead of echo (Lobby
# echo not available as bare name in single-session chk driver).

var x = 0; var fired = 0; at (Realm.x > 5) Realm.fired = Realm.fired + 1; var trigger = function() { Realm.x = 10 }; trigger(); Realm.fired
[00000000] 1
