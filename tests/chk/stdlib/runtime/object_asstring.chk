# Object.asString() — fallback on Object root for UVAL_OBJECT receivers.
# Legacy object.u:90-93: `asString` delegates to '$id'() which returns a
# type/address form.  This implementation produces <object 0x...> via
# uvalue_format, matching the REPL's rendering of UVAL_OBJECT values.
#
# Shadowing: Integer and Float have C-native asString slots (atoms.c);
# String's asString comes from the string_overlay.u scripted overlay
# (returns self).  All other atom kinds (nil, Boolean, ...) inherit the
# Object root directly and reach this fallback, which rejects them with
# a TypeError rather than formatting a garbage NULL pointer.
#
# Because the address is nondeterministic, object tests check stable
# properties: non-empty, correct type (String), and a fixed prefix.

# Plain object: returns a non-empty String.
Object.new().asString().isEmpty()
[00000000] false

# Prefix is "<object " (matches uvalue_format rendering).
Object.new().asString().startsWith("<object ")
[00000001] true

# A List is its own cell kind since the re-foundation, not a UObject, so
# it renders through the cell fallback rather than the <object 0x...>
# form.  What is pinned here is that asString answers with a String at
# all; the exact rendering of a container belongs to containers.c.
var lst = List.new(1,2,3); lst.asString().startsWith("<")
[00000002] true

# String receiver never reaches the Object-root fallback: the overlay
# slot (string_overlay.u) shadows it and returns self.
"x".asString()
[00000003] "x"

# Boolean and Nil now have scripted asString overlays (bool_nil_overlay.u)
# so they no longer reach this fallback.  String's overlay also shadows it.
# The Object root asString rejects other atom kinds that lack their own
# overlay.

