# Milestone: M6 Wave 2
# Covers: Phase 8 (T86) Math namespace constants.
#
# Math is a fresh proto UObject bound as a realm global by the post-loop
# hook urbi_stdlib_register_namespace_globals.  Phase 8 ships the IEEE-
# 754 constants only; Math.sin / cos / sqrt etc. land at Phase 10 via
# the .u stdlib overlay bouncing to the Float atom-proto methods that
# Phase 5 installed.
#
# Float literals (Gap #5) closed at v0.6.2; range checks now use direct
# float literals.

# pi within IEEE-754 tolerance (3 < pi < 4).
Math.pi > 3.0
[00000000] true

Math.pi < 4.0
[00000001] true

# e within IEEE-754 tolerance (2 < e < 3).
Math.e > 2.0
[00000002] true

Math.e < 3.0
[00000003] true

# NaN identifies as NaN via the Float.isNaN atom-proto method (Phase 5).
Math.nan.isNaN()
[00000004] true

# +Infinity identifies as such via Float.isInfinite (Phase 5).
Math.infinity.isInfinite()
[00000005] true
