# Milestone: M6 Wave 2
# Covers: Phase 8 (T87) System namespace primitives.
#
# System.time   — monotonic-microseconds reading scaled to seconds (Float).
#                 Uses vm->host_time_us which defaults to clock_gettime
#                 (CLOCK_MONOTONIC) on POSIX hosts; freestanding stub
#                 returns 0.
# System.cycle  — per-VM monotonic lookup-id counter (Integer).
# System.getenv — libc getenv() shim (hosted) or always-nil (freestanding).
# System.gc     — explicit full GC pass; returns nil.
#
# Wall-clock-since-epoch System.time semantics from legacy Urbi 2.x is
# narrowed to monotonic-since-VM-start at v1.0; full Date primitive
# arithmetic lands at Phase 9.

# System.time returns a positive Float (or zero on freestanding stub).
System.time() >= 0.asFloat()
[00000000] true

# System.cycle returns a positive Integer (lookup_id starts at 1).
System.cycle() > 0
[00000001] true

# System.cycle is monotonic — two reads with intervening work return >=.
var c1 = System.cycle(); var c2 = System.cycle(); c2 >= c1
[00000002] true

# System.gc returns nil and does not crash.
System.gc()
[00000003] nil

# System.getenv on a guaranteed-set variable (PATH on POSIX) is non-nil
# on hosted builds.  Freestanding stub always returns nil.  Either way,
# the result is acceptable — verify the function exists by calling it.
System.getenv("PATH") != "URBI_NEVER_SET_THIS"
[00000004] true
