# Milestone: v1.0-rc stdlib-completeness
# Covers: String split / join / format.
#
# split returns a List (which prints as <object ...> in the REPL — same as
# List.new(...)); its contents are verified via length()/get(i), matching
# the list_core.chk idiom.  join (self = separator) and format return Strings.
var p = "a,b,c".split(","); p.length()
[00000000] 3
var p = "a,b,c".split(","); p.get(0)
[00000001] "a"
var p = "a,b,c".split(","); p.get(2)
[00000002] "c"
var p = "a..b".split("."); p.length()
[00000003] 3
var p = "a..b".split("."); p.get(1)
[00000004] ""
var p = "xyz".split(","); p.length()
[00000005] 1
",".join(List.new("a","b","c"))
[00000006] "a,b,c"
"x=%s n=%d".format(List.new("hi", 7))
[00000007] "x=hi n=7"
"100%%".format(List.new())
[00000008] "100%"
"pi=%f".format(List.new(3.5))
[00000009] "pi=3.5"

# String % — infix format sugar.
# "fmt % arg" wraps a non-list arg in a one-element list before delegating
# to String.format.  A list arg is passed through unchanged.
"x=%s" % "hello"
[00000010] "x=hello"

"n=%d" % 42
[00000011] "n=42"

"x=%s, y=%s" % List.new("a", "b")
[00000012] "x=a, y=b"

"100%%" % List.new()
[00000013] "100%"

# split("") — per-byte split (legacy string.cc:385-391).
# Empty separator splits into individual characters, not one whole-string piece.
"abc".split("").length()
[00000014] 3

"abc".split("").get(0)
[00000015] "a"

"abc".split("").get(2)
[00000016] "c"

# Empty string split on "" yields an empty list (no chars to iterate).
"".split("").length()
[00000017] 0
