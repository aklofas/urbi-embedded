# Milestone: M6 Wave 2
# Covers: Phase 5 Float conversion methods.
#
# asString — UVALUE_FLOAT_FMT (%.14g + Lua trailing-.0 rule)
# asInteger — truncate toward zero (legacy: drops fractional part)
# asBoolean — non-zero predicate (false on +/-0.0; true on inf/nan)

4.asFloat().asString()
[00000000] "4.0"

0.asFloat().asString()
[00000001] "0.0"

(-3).asFloat().asString()
[00000002] "-3.0"

# Truncation toward zero.
4.asFloat().asInteger()
[00000003] 4

(-7).asFloat().asInteger()
[00000004] -7

# asBoolean: any non-zero is true.
0.asFloat().asBoolean()
[00000005] false

4.asFloat().asBoolean()
[00000006] true

(-1).asFloat().asBoolean()
[00000007] true
