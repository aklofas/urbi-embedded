# Milestone: M6 Wave 2 (updated v0.6.2: float literals now available)
# Covers: Phase 5 Float math methods.
#
# Float literals (Gap #5) closed at v0.6.2, so tests now use direct float
# syntax alongside the original asFloat() construction form.

# sqrt(4) = 2.0
4.asFloat().sqrt()
[00000000] 2.0

# sqrt(0) = 0.0
0.asFloat().sqrt()
[00000001] 0.0

# abs(-5.0) — both construction forms.
(-5).asFloat().abs()
[00000002] 5.0

# floor(7.5) using direct float literal (Gap #5 activated at v0.6.2).
7.5.floor()
[00000003] 7.0

# ceil(3.2) using direct float literal.
3.2.ceil()
[00000004] 4.0

# pow(2, 10) = 1024.0
var x = 10.asFloat()
[00000005] 10.0
2.asFloat().pow(x)
[00000006] 1024.0

# round(3.0) = 3.0
3.0.round()
[00000007] 3.0
