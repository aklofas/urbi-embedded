# Milestone: M3
# Covers: TAG_STOP is not intercepted by a try/catch block; the catch clause
#         is skipped and TAG_STOP continues propagating outward.
#
# Activated: v0.10.7 W7 — Tag.new() + tag.stop() shipped (v0.10.2 W4).
# Old label: T29
#
# Semantics: the unwind walker absorbs UEXEC_THROW in UCLEANUP_TRY_FRAME but
# does NOT absorb UEXEC_TAG_STOP; TAG_STOP propagates past catch clauses.
# `caught` remains 0 confirming catch was not executed.

var t = Tag.new()
var caught = 0
t: { try { t.stop() } catch (e) { Realm.caught = 1 } }
Realm.caught
[00000000] <Tag>
[00000000] 0
[00000000] nil
[00000001] 0
