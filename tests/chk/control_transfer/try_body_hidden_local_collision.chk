# Milestone: v0.13.5
# Covers: frame-locals declared inside a try body keep their registers —
#         the try result register is anchored in nactvar (hidden local,
#         urbi_emit_tag_prefix_arm pattern) so urbi_emit_fs_temp_floor's count-based math
#         stays contiguous and statement-boundary temp resets cannot hand
#         a body-declared local's register out as a temp.  Closes
#         design-risks v0.13.5-E (switch-in-try first-arm / for-each-in-try
#         collision) and v0.13.5-B (while-in-try loop-var clobber masking
#         the thrown value with a TypeError).

# --- switch inside try selects the matching arm (was: first arm always ran)
var s1 = "none"; try { switch (2) { case 1: { s1 = "one" }; case 2: { s1 = "two" } } } catch (var e) { s1 = "err" }; s1
[00000000] "two"

# --- switch inside try falls to default when no case matches
var s2 = "none"; try { switch (99) { case 1: { s2 = "one" }; default: { s2 = "def" } } } catch (var e) { s2 = "err" }; s2
[00000001] "def"

# --- for-each inside try completes (was: TypeError slot 'get' not found)
var s3 = "none"; try { for (var x : List.new(1, 2, 3)) { s3 = x }; s3 = "done" } catch (var e) { s3 = e.message }; s3
[00000002] "done"

# --- frame-local var + while + throw inside try: catch binds the thrown value
#     (was: the while condition's result temp clobbered `i`, so `i + 1`
#     raised a TypeError whose exception object reached the catch instead)
(function () { var c = 0; try { var i = 0; while (i < 1) { i = i + 1; throw 99 } } catch (e) { c = e }; return c })()
[00000003] 99

# --- frame-local loop var inside try survives the loop
(function () { var n = 0; try { var i = 0; while (i < 3) { i = i + 1 }; n = i } catch (e) { n = -1 }; return n })()
[00000004] 3
