# max_source_bytes is checked before the lexer runs, so oversized source
# is refused without being read at all — the cheapest of the three
# limits and the first to fire.
#
# A tight override of 5 rejects anything longer.

## mode: repl

@budget-source=5

> {"id":14,"op":"eval","code":"1+2+3+4"}
< "id":14 | "kind":"error" | "code":"budget_source"
< "id":14 | "kind":"done"
