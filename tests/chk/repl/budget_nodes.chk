# max_ast_nodes caps how much tree one request may allocate, which is
# the limit that bounds memory rather than stack.
#
# A tight override of 3 fails a four-term sum.

## mode: repl

@budget-nodes=3

> {"id":13,"op":"eval","code":"1+2+3+4+5"}
< "id":13 | "kind":"error" | "code":"budget_nodes"
< "id":13 | "kind":"done"
