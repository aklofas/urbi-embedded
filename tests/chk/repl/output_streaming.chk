# Output written inside an eval frame is streamed as it happens, one
# envelope per write, each carrying the eval's id — not batched into the
# result.  Three writes therefore produce three output envelopes ahead of
# the result and the done, in that order.

## mode: repl

> {"id":6,"op":"eval","code":"Lobby.__builtin_lobby_send(\"t1\", \"\", \"***\") ; Lobby.__builtin_lobby_send(\"t2\", \"\", \"***\") ; Lobby.__builtin_lobby_send(\"t3\", \"\", \"***\") ; 0"}
< "id":6 | "kind":"output" | *** t1
< "id":6 | "kind":"output" | *** t2
< "id":6 | "kind":"output" | *** t3
< "id":6 | "kind":"result" | "value":"0"
< "id":6 | "kind":"done"
