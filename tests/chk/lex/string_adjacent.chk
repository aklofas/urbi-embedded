# Milestone: M6
# Covers: adjacent string literals concatenate at
#         parse time.  "a" "b" produces the same interned UVAL_STR
#         pointer as "ab" so equality (pointer-compare) is true.

"a" "b" == "ab"
[00000000] true

# Three-way concat
"x" "y" "z" == "xyz"
[00000001] true

# Concat preserves interior content; round-trip through a var binding.
var hi = "hel" "lo"; hi
[00000002] "hello"
