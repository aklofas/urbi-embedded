# Milestone: M3
# Covers: t.block() pauses all strands tagged with t; t.unblock() resumes them;
#         new strand started while tag is blocked also stays paused.
# matrix-row: tag-block
#
# Host-driver form, so the tag is declared in its own `run` and the clock
# is virtual.  The expected block below is this core's block, a gate
# (REVIVAL §14 S-tag-state-full): a blocked strand is held, not killed,
# and runs on from where it was once unblocked.  The legacy
# tests/2.x/tag/block.chk is written against a block that kills, so its
# expectations are not these.
#
# 1. A loop under `t` echoes once per second.
# 2. While `t` is blocked two seconds pass and nothing echoes.
# 3. A second loop entered under the blocked `t` is held before its first
#    echo -- and so is the chunk that entered it, which is why that `run`
#    hands back nil, not its trailing 0.
# 4. After unblock both loops echo; a stop ends them and leaves no work.
## timeout: 30
## host: run var t = Tag.new()
## host: run t: detach { while (true) { echo("1"); sleep(1s) } }; 0
## host: advance-clock 1000
## host: step 1000
## host: run t.block()
## host: advance-clock 1000
## host: step 1000
## host: advance-clock 1000
## host: step 1000
## host: run t: detach { while (true) { echo("2"); sleep(1s) } }; 0
## host: advance-clock 1000
## host: step 1000
## host: run t.unblock()
## host: step 1000
## host: advance-clock 1000
## host: step 1000
## host: run t.stop()
## host: advance-clock 1000
## host: step 1000
## host: live-work
[00000000] <Tag>
[00000000] *** 1
[00000000] 0
[00000000] *** 1
[00000000] step: WAKE_AT
[00000000] nil
[00000000] step: QUIESCENT
[00000000] step: QUIESCENT
[00000000] nil
[00000000] step: QUIESCENT
[00000000] *** 1
[00000000] *** 2
[00000000] nil
[00000000] step: WAKE_AT
[00000000] *** 1
[00000000] *** 2
[00000000] step: WAKE_AT
[00000000] nil
[00000000] step: QUIESCENT
[00000000] live-work: false
