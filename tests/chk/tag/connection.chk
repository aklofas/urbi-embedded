# Milestone: v0.10.10-job-introspection
# Covers: connection tag is always present in Job.current.tags; tagged blocks
#         add their tag to the ambient tag list visible via Job.current.tags.
# matrix-row: scheduler-jobs
#
# Rewritten from legacy tests/2.x/tag/connection.chk.  `Job.current` and
# `tags` are methods here.  Lists render opaquely and `==` on two lists
# does not compare their elements, so the legacy `tags == [connectionTag,
# t]` is spelled as a size plus membership.  The list order is not
# pinned: this core lists the scope tags before the connection tag, the
# legacy one after it.  The last case is the legacy `&` pair: each arm
# sees its own scope tag and not its sibling's.
var l = Job.current().tags()
l.size()
l.has(connectionTag)
var t = Tag.new()
var u = Tag.new()
t: { var l = Job.current().tags(); l.size() }
t: { var l = Job.current().tags(); l.has(t) && l.has(connectionTag) }
t: { u: { var l = Job.current().tags(); l.size() } }
t: { u: { var l = Job.current().tags(); l.has(t) && l.has(u) && l.has(connectionTag) } }
var r1 = nil
var r2 = nil
{ t: { r1 = Job.current().tags().has(u) } } & { u: { r2 = Job.current().tags().has(t) } }
r1
r2
Job.current().tags().size()
[00000001] <?>
[00000002] 1
[00000003] true
[00000004] <Tag>
[00000005] <Tag>
[00000006] 2
[00000007] true
[00000008] 3
[00000009] true
[00000010] nil
[00000011] nil
[00000012] <?>
[00000014] false
[00000015] false
[00000016] 1
