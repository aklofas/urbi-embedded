# Covers: tag.stop() called from an AT_SYNC watcher body -- that is, from
#         inside the drain's own walk -- cancels a `waituntil` member of
#         that tag without disturbing the walk, and the VM still reaches
#         quiescence.
# matrix-row: tag-stop
#
# The at-sync body runs inline on a spare strand during the drain, and
# t.stop() cancels both the waiting strand and the tag's watchers.
# Cancelling a watcher only clears its `armed` flag; the list is compacted
# by a sweep that runs outside the walk, so the walk's pointers stay valid
# -- the whole class of mid-walk free the old core needed a
# PENDING_UNREGISTER flag and a rescan to survive.
#
# HISTORY.  This fixture pinned "WA" under the old finish-then-drop rule;
# see tag/stop_straightline_ret.chk for why a cancelled wait now stops.
## timeout: 30
## host: run var t = Tag.new()
## host: run Realm.flag = 0
## host: run Realm.go = 0
## host: run Realm.log = ""
## host: run at sync (Realm.go == 1) { Realm.t.stop() }
## host: run t: { waituntil(Realm.flag == 1); Realm.log = Realm.log + "W" }; Realm.log = Realm.log + "A"
## host: run var trig = function() { Realm.go = 1 }; Realm.trig()
## host: run Realm.log
## host: run var nop = function() { 0 }; Realm.nop()
## host: step 1000
[00000000] <Tag>
[00000000] 0
[00000000] 0
[00000000] ""
[00000000] nil
[00000000] nil
[00000000] 1
[00000000] "A"
[00000000] 0
[00000000] step: QUIESCENT
