# Milestone: M3
# Covers: ambient tag chain is inherited by strands spawned via the `,`
#         (fork-detach) separator; tag.stop() on the ambient tag cascades to
#         the parallel strand.
# matrix-row: tag-ambient
#
# Host-driver form, with a virtual clock.  Inside each tag scope the `,`
# detaches its LEFT arm, a sleeper, and runs the right arm inline.  Under
# `c`, which nobody stops, the sleeper logs when the clock moves; under
# `u`, the stop issued after the scope has returned still reaches the
# detached sleeper, which therefore never logs.
## timeout: 30
## host: run var c = Tag.new()
## host: run var u = Tag.new()
## host: run var log = ""
## host: run c: { { sleep(1s); log = log + "C" }, { log = log + "c" } }; 0
## host: run u: { { sleep(1s); log = log + "U" }, { log = log + "u" } }; 0
## host: run u.stop()
## host: advance-clock 2000
## host: step 1000
## host: run log
## host: live-work
[00000000] <Tag>
[00000000] <Tag>
[00000000] ""
[00000000] 0
[00000000] 0
[00000000] nil
[00000000] step: QUIESCENT
[00000000] "cuC"
[00000000] live-work: false
