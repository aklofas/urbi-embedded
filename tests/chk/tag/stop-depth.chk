# Milestone: M3
# Covers: stopping an outer tag terminates nested tag scopes; stopping an inner
#         tag leaves the outer scope running; echo traces enter/leave ordering.
# matrix-row: tag-stop
#
# Rewritten from legacy tests/2.x/stop-depth.chk for the host driver; the
# echo trace is the legacy one line for line.  Named-function declarations
# are not parsed, so `f` is a `var` holding a function.  The 3600s sleep
# never comes due: the last step finds no live work left.
## timeout: 30
## host: run var t = Tag.new()
## host: run var u = Tag.new()
## host: run var f = function() { echo("Entering f"); t: { echo("Entering t"); u: { echo("Entering u"); sleep(3600s); echo("Leaving u") }; echo("Leaving t") }; echo("Leaving f") }
## host: run f(), 0
## host: step 1000
## host: run t.stop(); u.stop()
## host: step 1000
## host: run f(), 0
## host: step 1000
## host: run u.stop()
## host: step 1000
## host: live-work
[00000000] <Tag>
[00000000] <Tag>
[00000000] <?>
[00000000] *** Entering f
[00000000] *** Entering t
[00000000] *** Entering u
[00000000] 0
[00000000] step: WAKE_AT
[00000000] *** Leaving f
[00000000] nil
[00000000] step: QUIESCENT
[00000000] *** Entering f
[00000000] *** Entering t
[00000000] *** Entering u
[00000000] 0
[00000000] step: WAKE_AT
[00000000] *** Leaving t
[00000000] *** Leaving f
[00000000] nil
[00000000] step: QUIESCENT
[00000000] live-work: false
