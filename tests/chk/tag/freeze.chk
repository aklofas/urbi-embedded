# Milestone: M3
# Covers: tag.freeze() suspends all strands under that tag; the strand stays
#         frozen until t2.stop() terminates the outer scope.
# matrix-row: tag-freeze
#
# Rewritten from legacy tests/2.x/freeze.chk for the host driver: each
# declaration is its own `run`, and the second's sleep is moved past by
# the virtual clock.  The frozen strand never echoes, a stop of the
# outer tag ends it, and no work is left.
## timeout: 30
## host: run var t1 = Tag.new()
## host: run var t2 = Tag.new()
## host: run t2: { t1: t1.freeze(); echo("You don't see me") }, 0
## host: run sleep(1s); echo("I am the only one")
## host: advance-clock 1000
## host: step 1000
## host: step 1000
## host: run t2.stop()
## host: step 1000
## host: live-work
[00000000] <Tag>
[00000000] <Tag>
[00000000] 0
[00000000] nil
[00000000] *** I am the only one
[00000000] step: QUIESCENT
[00000000] step: QUIESCENT
[00000000] nil
[00000000] step: QUIESCENT
[00000000] live-work: false
