# Covers: stopping a tag whose member is genuinely SUSPENDED (not merely
#         WAITING) wakes that member so its finally still runs.
# Origin: harvested from tests/unit/test_tag_gate_matrix.c
#         (deleted in Phase 0)
#
# The member strand parks on `waituntil`, then t.block() suspends it.
# Setting Realm.go = 1 would normally wake a plain waituntil — the wake
# funnel instead routes it to SUSPENDED because the block gate is still
# held (SCHED-08, src/sched/ustrand.c), so Realm.log stays "" even after
# stepping: the member is confirmed suspended, not just parked.  Only
# t.stop() forces the unwind through regardless of the block gate —
# cancellation overrides suspension — running the finally body.
## timeout: 30
## host: run var t = Tag.new()
## host: run Realm.log = ""
## host: run Realm.go = 0
## host: run t: { try { waituntil(Realm.go == 1) } finally { Realm.log = Realm.log + "F" } }; 0
## host: run t.block()
## host: run Realm.go = 1
## host: step 1000
## host: run Realm.log
## host: run t.stop()
## host: step 1000
## host: run Realm.log
[00000001] <Tag>
[00000002] ""
[00000003] 0
[00000004] nil
[00000005] nil
[00000006] 1
[00000007] step: QUIESCENT
[00000008] ""
[00000009] nil
[00000010] step: QUIESCENT
[00000011] "F"
