# Milestone: M3 (activated v0.8.0 — persistent loader strand)
# Covers: forked runners sharing environment via '&'; both branches read
#         and write the outer var; join waits for both branches to complete.
#
# v1.0 adaptation: block-in-fork ({...} & {...}) does not parse because
# parse_expression does not accept LBRACE as a prefix; use parenthesised
# expressions and Realm-qualified slot writes instead.  Semantics are
# identical: both fork arms execute in the same shared environment.

# Read test: both arms read x=0 from shared env and increment a counter.
# seen ends at 2 (each arm adds x+1 = 1).
var x = 0; var seen = 0
(Realm.seen = Realm.seen + Realm.x + 1) & (Realm.seen = Realm.seen + Realm.x + 1)
Realm.seen
[00000000] 0
[00000001] <?>
[00000002] 2

# Write test: each arm writes to a separate slot; join waits for both.
var x2 = 0; var y2 = 0
(Realm.x2 = 42) & (Realm.y2 = 51)
Realm.x2
Realm.y2
[00000003] 0
[00000004] <?>
[00000005] 42
[00000006] 51
