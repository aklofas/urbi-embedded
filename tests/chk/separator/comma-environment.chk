# Milestone: M3 (activated v0.8.0 — persistent loader strand)
# Covers: detached runner sharing environment via ','; child reads and
#         writes the outer var.
#
# v1.0 adaptation: sleep() is not registered at this milestone (deferred T43);
# timing-dependent output ordering from the legacy fixture is replaced by
# cross-step observation.  The detached arm runs between REPL steps, so its
# writes are visible on the next input line.  Realm-qualified slot access is
# used because block-in-fork ({...},) does not parse (parse_expression does
# not accept LBRACE as a prefix).

# Read test: detached arm reads x=0 and records it (detached_saw = x+100=100);
# main arm also reads x=0.  After the step detached_saw is 100.
var x = 0; var detached_saw = 0
(Realm.detached_saw = Realm.x + 100) , Realm.x
Realm.detached_saw
[00000000] 0
[00000001] 0
[00000002] 100

# Write test: detached arm writes x2=42; main arm reads x2=0 (not yet written);
# after main yields the detached arm runs and x2 becomes 42.
var x2 = 0
(Realm.x2 = 42) , Realm.x2
Realm.x2
[00000003] 0
[00000004] 0
[00000005] 42
