# Milestone: v0.13.5
# Covers: blocks as & / | operands — the signature parallel-composition
# syntax accepts statement forms, not only expressions.
#
# Note: & RHS is compiled as a closure thunk. Both reads and writes of
# chunk-top vars work — urbi_emit_assign_arm now walks the parent chain to the
# root funcstate's global_var_names and emits OP_SETSLOT via the thunk's
# own r_global_slot (same path reads use). The | operands are emitted inline
# so local vars work there directly.

Realm.ta = 0; Realm.tb = 0; { Realm.ta = 1 } & { Realm.tb = 2 }; Realm.ta + Realm.tb
var s = ""; { s = s + "x" } | { s = s + "y" }; s
Realm.fn = 0; if (true) { Realm.fn = 1 } & { Realm.fn = Realm.fn + 10 }; Realm.fn
[00000000] 3
[00000001] "xy"
[00000002] 11
