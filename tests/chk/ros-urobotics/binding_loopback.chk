# Milestone: v0.12.3-ros-demo-and-contract
# Covers: facet<->ROS2 binding loop on the mock transport — bindInput drives
#         a facet slot from an injected message, a reactive behavior fires on
#         the bound slot, and bindOutput publishes the slot value.
#
# tunables: ros-urobotics
#
# Sequence:
#   1. bindInput wires /range -> sensor.distance
#   2. bindOutput wires motor.val -> /cmd (on-demand, rate=0ms)
#   3. at (sensor.distance < 0.5) motor.val = 0.0  -- reactive safety behavior
#   4. Inject a sensor_msgs/Range with range=0.3 (< threshold)
#   5. sleep(1ms) -- lets the subscription event body run and update sensor.distance
#   6. Verify sensor.distance updated to ~0.3 (proves bindInput)
#   7. publishNow() -- the deferred slot-change drain fires the at-watcher body
#      (motor.val -> 0.0) at the bytecode safepoint inside publishNow's
#      execution, so publish reads 0.0; __lastPublished returns the published
#      Float64 (proves reactive chain + bindOutput both directions)
#
# Subscribe handle: 0 (bindInput -> ros.subscribe); publisher handle: 1 (bindOutput -> ros.publisher).
# sensor_msgs/Range.range is float32, so 0.3 appears as 0.30000001192093 (IEEE 754 float32 rounding).

ros.init("n"); var sensor = Robotics.DistanceSensor.clone(); sensor.distance = 1.0; var motor = Robotics.Motor.clone(); motor.val = 1.0;
[00000000] 1.0
var insub = Robotics.bindInput(sensor, "distance", "/range", "sensor_msgs/Range", "range");
[00000001] <event>
var out = Robotics.bindOutput(motor, "val", "/cmd", "std_msgs/Float64", "data", 0ms); nil
[00000002] nil
at (sensor.distance < 0.5) motor.val = 0.0;
[00000003] nil
var rm = ros.msg("sensor_msgs/Range"); rm.range = 0.3; ros.__injectMsg(0, rm);
[00000004] nil
sleep(1ms);
[00000005] nil
sensor.distance
[00000006] 0.30000001192093
out.publishNow(); ros.__lastPublished(1).data
[00000007] 0.0
