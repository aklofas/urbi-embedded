// stdlib_later.u — the script half of the standard library that is NOT
// baked yet.
//
// Each block below needs a subsystem that does not exist on this branch.
// The bake tool never reads this file; when the blocking task lands, its
// block moves into stdlib.u and the next bake picks it up.
//
//   Lobby.wall             — needs Lobby.lobbies, i.e. REPL sessions.
//   Lobby.handleDisconnect — needs events (`onDisconnect!`).
//   detach / disown        — need the scheduler's __detach_strand and
//                            __disown_strand primitives.

// ==== from lobby.u (needs Lobby.lobbies and events) ====

class LobbyMethods {
    // wall(msg, tag): broadcast to every OTHER lobby.  Sequential (no
    // `for|`) so a partial delivery cannot strand mid-loop on the
    // host-call boundary.
    var wall = function(msg, tag) {
        var n = Lobby.lobbies.length();
        var i = 0;
        while (i < n) {
            var l = Lobby.lobbies.get(i);
            if (l != this) { l.echo(msg, tag, "***") };
            i = i + 1
        }
    };

    // handleDisconnect: fired by the session dispatcher on destroy.
    // Overridable per instance; the default emits onDisconnect.
    var handleDisconnect = function() {
        onDisconnect!(this)
    }
} |

Lobby.addProto(LobbyMethods);

// ==== from control_overlay.u (needs the scheduler) ====

// control_overlay.u — v0.10.10 / D7-C.
//
// Lazy-arg wrappers around the C-native __detach_strand /
// __disown_strand.  The lazy parameter machinery (AST_LAZY_PARAM +
// uemit_stmt.c lazy_arg_context) wraps the call-site expression in an
// implicit closure when detach/disown are called from the same
// compilation unit; the natives receive that closure and spawn it as
// a new strand.
//
// detach: child inherits the parent's ambient tag chain.
// disown: child inherits the connection tag only (all user tags stripped).
//
// Reference: legacy share/urbi/control.u:23-31 — same shape, same
// semantics, ported to our lazy-param syntax.

var detach = function(lazy fun) {
    __detach_strand(fun)
};

var disown = function(lazy fun) {
    __disown_strand(fun)
};
