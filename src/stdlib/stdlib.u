// stdlib.u — the script half of the standard library.
//
// One file, baked into one chunk (src/stdlib/urbi_stdlib_bytecode.gen.c)
// and run once per VM by uboot_init with the receiver set to the shared
// root globals object.  Its top-level declarations therefore become
// slots every realm inherits, built once rather than per realm.
//
// What belongs here rather than in C: anything expressible in
// urbiscript that does not have to exist before a script can run.  The
// exception FAMILY is the counter-example and lives in rt/uboot.c --
// the runtime has to be able to throw a TypeError before this file has
// been loaded.
//
// The house pattern is `class XMethods { ... }` followed by
// `Target.addProto(XMethods)`, not a direct write to the prototype:
// the built-in prototypes are shared, several are sealed read-only
// after boot, and addProto composes where an assignment would clobber.
//
// Content still waiting on a subsystem lives in stdlib_later.u, which
// is NOT baked; see the banner there.
//
// Legacy reference: legacy/repos/aldebaran-urbi/share/urbi/*.u.

// === mixins ===============================================================
//
// Marker protos the container types attach to, plus the iteration
// surface anything with length() and get(i) inherits by adding
// RangeIterable to its chain.

class Comparable {} |
class Orderable  {} |
class RangeIterable {
    var each = function(f) { var i = 0; var n = this.length(); while (i < n) { f(this.get(i)); i = i + 1 }; nil };
    var all  = function(pred) { var i = 0; var n = this.length(); var r = true;  while (i < n) { if (pred(this.get(i)) == false) { r = false }; i = i + 1 }; r };
    var any  = function(pred) { var i = 0; var n = this.length(); var r = false; while (i < n) { if (pred(this.get(i))) { r = true }; i = i + 1 }; r }
} |

// === exception subclasses =================================================
//
// Only the ones the VM never raises itself.  Exception, TypeError,
// ArityError, LookupError, OutOfMemoryError, IndexError, RangeError and
// DivByZero are table rows in rt/uboot.c and are NOT redeclared
// here: a second declaration would both shadow the protos the runtime
// throws and fail, because their globals are constant.
//
// `Lookup` is the legacy spelling of LookupError, kept reachable as
// `Exception.Lookup`.

class KeyError        : public LookupError {} |
class IOError         : public Exception {} |
class CapacityError   : public Exception {} |
class RuntimeError    : public Exception {} |
class SchedulingError : public Exception {} |
class SyntaxError     : public Exception {} |
class ExceptionLookupAlias {
    var Lookup = LookupError
} |
Exception.addProto(ExceptionLookupAlias);

// === Singleton ============================================================
//
// A proto whose clone and new both answer the prototype itself, so
// there is exactly one of it.

class Singleton {
    var clone = function() { this };
    var new   = function() { this }
} |

// === number ===============================================================

class IntegerMath {
    var sqr  = function() { this * this };
    var abs  = function() { if (this < 0) { 0 - this } else { this } };
    var sign = function() { if (this < 0) { -1 } else { if (this > 0) { 1 } else { 0 } } };
    var even = function() { this.and(1) == 0 };
    var odd  = function() { this.and(1) != 0 };
    var times = function(f) { var i = 0; while (i < this) { f(i); i = i + 1 }; nil };
    var upto  = function(hi, f) { var i = this; while (i <= hi) { f(i); i = i + 1 }; nil }
} |
class FloatMath {
    var sqr  = function() { this * this };
    var sign = function() { if (this < 0.0) { -1 } else { if (this > 0.0) { 1 } else { 0 } } }
} |
Integer.addProto(IntegerMath) |
Float.addProto(FloatMath);

// === String ===============================================================
//
// size / isEmpty / startsWith / endsWith / asString are C natives; these
// are the spellings the legacy library adds on top of them.

class StringMethods {
    var nonEmpty  = function() { this.isEmpty() == false };
    var hasPrefix = function(s) { this.startsWith(s) };
    var hasSuffix = function(s) { this.endsWith(s) }
} |
String.addProto(StringMethods);

// === Boolean and Nil ======================================================

class BoolMethods {
    var asString = function() { this.toString() }
} |
Boolean.addProto(BoolMethods) ;
class NilMethods {
    var asString = function() { "nil" }
} |
Nil.addProto(NilMethods);

// === List and Dict ========================================================
//
// The C tables in src/stdlib/containers.c carry everything that touches
// the backing store: new, length, isEmpty, get, set, add, contains,
// concat, diff, sort, reverse, join and the legacy aliases.  What is
// here is the higher-order surface, which is script because it calls
// back into script.
//
// each / all / any are RangeIterable's — a List has length() and get(i),
// which is the whole of what that mixin derives from, so they are not
// written a second time here.
//
// Legacy reference: share/urbi/list.u and share/urbi/dict.u.

class ListMethods {
    // map(f): a new List of f applied to each element.
    var map = function(f) {
        var res = List.new();
        var i = 0;
        var n = this.length();
        while (i < n) {
            var v = f(this.get(i));
            res.add(v);
            i = i + 1
        };
        res
    };

    // filter(pred): a new List of the elements pred accepts.
    var filter = function(pred) {
        var res = List.new();
        var i = 0;
        var n = this.length();
        while (i < n) {
            var v = this.get(i);
            if (pred(v)) { res.add(v) };
            i = i + 1
        };
        res
    };

    // foldl(f, acc): left fold.
    var foldl = function(f, acc) {
        var res = acc;
        var i = 0;
        var n = this.length();
        while (i < n) {
            var next = f(res, this.get(i));
            res = next;
            i = i + 1
        };
        res
    };

    // has(e): membership, over the C-native contains.
    var has = function(e) { this.contains(e) };

    // head(): the first element.  Legacy alias for front()
    // (list.u:106 copySlot("front","head")); raises on the empty list
    // through get(0)'s bounds check.
    var head = function() { this.get(0) }
} |
List.addProto(RangeIterable) |
List.addProto(ListMethods);

// Mutation during iteration: `n` is read once at entry, so an element
// appended under each/map/filter is not visited, and removing one
// shifts the indices that are still to come.  sort() is the mutation-safe
// one — it copies the backing store before any comparator runs.

class DictMethods {
    // getWithDefault(key, dflt): dflt when the key is absent, which is
    // what tells an absent key from one whose value is nil.
    var getWithDefault = function(key, dflt) {
        if (this.has(key)) { this.get(key) } else { dflt }
    };

    // setIfAbsent(key, val): the existing value, or val after storing it.
    var setIfAbsent = function(key, val) {
        if (this.has(key)) { this.get(key) } else { this.set(key, val); val }
    };

    // each(f): f(key, value) over a keys() snapshot taken at entry.  An
    // entry added under the loop is not visited; one removed before its
    // key comes up reads back as nil rather than raising.
    var each = function(f) {
        var ks = this.keys();
        var i = 0;
        var n = ks.length();
        while (i < n) {
            var k = ks.get(i);
            f(k, this.get(k));
            i = i + 1
        };
        nil
    }
} |
Dict.addProto(DictMethods);

// === Channel ==============================================================
//
// A named output stream.  echo tags every message with the channel's
// name; `<<` is the legacy shift-write spelling and returns `this` so
// `c << "a" << "b"` chains left to right.
//
// Ported from legacy/repos/aldebaran-urbi/share/urbi/channel.u:24-65.
// Channel.Filter is not here: it needs Container.any / Container.all,
// which arrive with the full container surface.

class ChannelMethods {
    var enabled = true;
    var quote = true;
    var name = "";

    var new = function(n) {
        var inst = this.clone();
        inst.init(n)
    };

    var init = function(n) {
        this.name = n;
        this
    };

    var echo = function(msg) {
        Lobby.echo(msg, this.name, "***")
    };

    var '<<' = function(x) {
        if (this.enabled) {
            Lobby.echo(x, this.name, "***")
        };
        this
    }
} |
Channel.addProto(ChannelMethods);

// The three standard channels.  Legacy urbi binds them as realm globals
// so `cout << "x"` works unqualified; they are ordinary Channel
// instances differing only in their tag.

var cout = Channel.new("output") |
var cerr = Channel.new("error") |
var clog = Channel.new("clog") |

// === control (needs the scheduler's spawn primitives) =====================
//
// Lazy-argument wrappers around the C natives.  `lazy` makes the caller's
// expression arrive as a closure instead of a value, which is the whole
// point: `detach(f())` must spawn a strand that calls f, not call f and
// spawn nothing.
//
// detach: the child keeps the caller's ambient tag, so a stop on an
//   enclosing scope reaches it.
// disown: the child keeps only the realm's connection tag, so it outlives
//   the scope that spawned it but still dies with its realm.
//
// Legacy reference: legacy/repos/aldebaran-urbi/share/urbi/control.u.

var detach = function(lazy fun) {
    __detach_strand(fun)
} |

var disown = function(lazy fun) {
    __disown_strand(fun)
};
