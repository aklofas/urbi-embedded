// Lobby stdlib — v0.9.1 Phase 5.
//
// Adds the script-side method surface (echo / wall / handleDisconnect)
// on top of the Lobby proto.  The Lobby proto itself (vm->lobby_proto)
// is created by C-side urbi_lobby_native_register at stdlib boot, along
// with three VM-singleton slots:
//
//   __builtin_lobby_send  — native primitive routing through the per-
//                           realm writer fallback chain.
//   lobbies               — empty List populated/depopulated by C-side
//                           urbi_lobby_register_session / unregister_-
//                           session (the REPL dispatcher).
//   onDisconnect          — Event subscribed to by user code; the
//                           default handleDisconnect below emits it
//                           with the disconnecting session lobby as
//                           the payload.
//
// State on Lobby (not on LobbyMethods) is critical: lobby.u runs once
// per realm (the .u bake-blob's deferred run fires from urbi_populate_-
// realm_globals on every realm creation).  Each run prepends a fresh
// LobbyMethods to Lobby.protos via addProto, so subsequent realms see
// their OWN LobbyMethods first in DFS order — but the shared lobbies
// and onDisconnect slots on Lobby are found further along the chain,
// uniformly across every session.
//
// Why methods on LobbyMethods (not on Lobby directly):
//   The Lobby proto is marked URBI_OBJ_FLAG_READONLY by Phase-5
//   mark_readonly BEFORE this overlay runs (spec section 3.6 + 4.2 -
//   Lobby joins the 15-element readonly cohort).  Direct OP_SETSLOT
//   writes to a readonly proto raise TypeError; the LobbyMethods +
//   addProto pattern parallels list_overlay.u / dict_overlay.u and
//   works because addProto is a C-native method that bypasses the
//   OP_SETSLOT readonly check.
//
// Slot lookup on a session lobby instance walks:
//   instance -> Lobby (lobbies/onDisconnect/__builtin_lobby_send)
//            -> LobbyMethods (echo/wall/handleDisconnect)
//            -> root Object
// `this` binds to the instance, so `onDisconnect!(this)` emits with
// the per-session lobby as the value.
//
// Legacy reference: share/urbi/lobby.u (Gostai 2008-2012).

class LobbyMethods {
    // echo(msg, tag, prefix): format and write to the current realm's
    // writer via the __builtin_lobby_send C primitive (which routes
    // through urbi_vm_write_in_realm so per-session writers win).
    // tag is typically the empty string ""; prefix typically "***".
    var echo = function(msg, tag, prefix) {
        __builtin_lobby_send(msg.asString(), tag, prefix)
    };

    // wall(msg, tag): broadcast to every OTHER lobby in Lobby.lobbies.
    // Skips `this` so the originating session doesn't receive its own
    // broadcast.  Sequential iteration (no for|) so partial delivery
    // cannot strand mid-loop on the host-call boundary.
    var wall = function(msg, tag) {
        var n = Lobby.lobbies.length();
        var i = 0;
        while (i < n) {
            var l = Lobby.lobbies.get(i);
            if (l != this) { l.echo(msg, tag, "***") };
            i = i + 1
        }
    };

    // handleDisconnect: per-instance overrideable hook fired by the C
    // dispatcher (urbi_lobby_invoke_handleDisconnect) on session
    // destroy.  Default fires the onDisconnect event for any
    // subscribers (the `!` postfix desugars to `.emit([arg])`).  User
    // code overrides per-instance via `this.handleDisconnect =
    // function() { ... }` from inside the session — the instance-local
    // slot wins over this proto default.
    var handleDisconnect = function() {
        onDisconnect!(this)
    }
} |

Lobby.addProto(LobbyMethods);
