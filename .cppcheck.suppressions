// cppcheck suppressions: one per intentional violation.
// Format: <id>:<file>:<line>  followed by `// audit:<ID> <rationale>`.
// File-wide form `<id>:<file>` and project-wide `<id>:*` also accepted.
//
// Common categories to expect:
//   missingIncludeSystem  — system includes intentionally not parsed
//   unusedFunction        — public C API consumed by tests/ + external embedders
//                           (cppcheck scans src/ only — every public-API entry
//                           point looks unused from its perspective)
//   constParameterCallback— argv const-cast would cascade into every callback
//                           function-pointer site; cppcheck flags this itself

// =============================================================================
// Project-wide: unusedFunction (Phase 19)
// =============================================================================
// audit:CPPCHK-009 (Phase 19) — cppcheck scans src/ only; the public C API
// surface (urbi_*, helper definitions used by tests/, native callbacks invoked
// via function-pointer tables) is structurally unreachable from cppcheck's
// call-graph view.  Suppressing the whole category project-wide is correct
// here: removing or marking-static any public-API symbol would break
// test/ binaries or external embedders.  Re-evaluate if cppcheck gains
// cross-TU resolution for header-declared exports.
unusedFunction

// =============================================================================
// src/vm/uvm.c — computed-goto dispatch table
// =============================================================================
// audit:CPPCHK-010 (Phase 19) — cppcheck cannot parse GCC's label-address
// operator `&&label` (it sees `&&` as logical-and producing a bool), so it
// flags every dispatch_table entry as `assignBoolToPointer` and every
// `label_OP_*:` target as `unusedLabelConfiguration` (claiming the labels
// only exist under preprocessor branches).  Both are correctness-stable
// false positives: UVM_USE_COMPUTED_GOTO=1 is the host build mode, the
// labels are jumped to via `goto *dispatch_table[opcode]` at the dispatch
// hot loop (src/vm/uvm.c near line 290).  Suppressing file-wide because
// every opcode handler is affected.
assignBoolToPointer:src/vm/uvm.c
unusedLabelConfiguration:src/vm/uvm.c

// =============================================================================
// Per-site suppressions
// =============================================================================

// audit:CPPCHK-002 lookup_id rollover guard — three sites where cppcheck's
// static analysis assumes 32-bit lookup_id and reports the (uint32_t) cast on
// (lookup_id + 1ULL) as always false.  vm->lookup_id is uint64_t; the cast
// catches the actual u32 wrap (every ~4B lookups) where the stamp would
// collide with the "no stamp" sentinel 0.  Guard is live correctness on
// 64-bit hosts and required for stamp-uniqueness during DFS traversal.
// Verified 2026-05-08 against src/vm/uvm.h:128 (uint64_t lookup_id field).
knownConditionTrueFalse:src/object/uobject_lookup.c:86
knownConditionTrueFalse:src/object/uobject_lookup.c:124
knownConditionTrueFalse:src/object/uobject_slot.c:553

// audit:CPPCHK-011 (Phase 19) — pattern_matches() is an M3 catch-everything
// stub that always returns 1 (src/runtime/uunwind.c:65 docstring); cppcheck
// correctly flags the call-site as `always true`.  M5 refines pattern dispatch
// to actual exception-class matching (see comment block at uunwind.c:55-62);
// suppressing keeps the gate green until that lands.
//
// CPPCHK-001 (defer:M6) is the same finding under a different ID — filed
// before CPPCHK-011 from a different cppcheck pass and resolved transitively
// when Phase 19 closed CPPCHK-011.  Both close at v0.6.1-stdlib (Phase 12).
knownConditionTrueFalse:src/runtime/uunwind.c:313

// audit:CPPCHK-012 (Phase 19, closed Phase 9) — constParameterCallback
// previously fired on event_sync_emit_method in uevent_native.c when
// the callback function-pointer type was registered via event_native_register.
// Subsequent refactoring moved the callback to direct-call registration;
// cppcheck no longer detects the pattern.  Suppression retired.

// audit:CPPCHK-013 (Phase 19, updated Phase 6, retired v0.8.0) — parse_err_line /
// parse_err_col suppressions retired: v0.8.0 Task 8 refactored urbi_run_chunk to
// use persistent loader strands, moving the parse-error path.  Under current
// cppcheck version, the pattern (write in freestanding, read in __STDC_HOSTED__)
// no longer triggers unreadVariable warnings; modern cppcheck tracks
// configuration-conditional paths more precisely.  Suppressions removed.

// audit:CPPCHK-Phase5 — src/stdlib/atoms.c's DEF_INT_BINOP macro
// expands to native-method callbacks whose signature is pinned by the
// urbi_native_method_fn typedef (UVM *vm, UValue self, UValue *args,
// uint8_t nargs, UValue *out).  cppcheck flags `args` as constable
// because the macro body only reads args[0]; const-casting would
// cascade through every native-method registration site.  Mirrors the
// rationale at CPPCHK-012 above.
constParameterPointer:src/stdlib/atoms.c

// audit:CPPCHK-Phase6 — src/stdlib/containers.c native-method callbacks
// are bound by the same urbi_native_method_fn typedef as atoms.c
// (CPPCHK-Phase5 above).  cppcheck flags `args` as constable plus
// several local UList* / UDict* / UDictEntry* pointers loaded via
// list_storage / dict_storage / dict_lookup that are read-only in their
// branches; promoting those locals to `const` cascades into the helper
// signatures, which the broader Phase 6 design keeps non-const so the
// same locals can take a write-through path on the mutating method
// branches (set / add / remove / dict_set / etc.).
constParameterPointer:src/stdlib/containers.c
constVariablePointer:src/stdlib/containers.c

// audit:CPPCHK-Phase7 — src/stdlib/runtime_types.c native-method callbacks
// expose UValue *args as part of the urbi_native_method_fn typedef; the
// Exception primitive's exc_new only reads args[0] so cppcheck flags it,
// but the function-pointer signature is pinned and cannot be const-qualified
// without breaking every callback registration site.
constParameterPointer:src/stdlib/runtime_types.c

// audit:CPPCHK-Phase9 — src/stdlib/primitives.c native-method callbacks
// (Mutex / Date / Duration .new / .fromSeconds / .fromMicroseconds / .plus)
// expose UValue *args via the urbi_native_method_fn typedef; same rationale
// as Phase 7 — the function-pointer signature is pinned.
constParameterPointer:src/stdlib/primitives.c

// audit:CPPCHK-Phase-v091 — src/stdlib/debug_namespace.c native-method
// callbacks (Debug.stack / Debug.slots / etc.) expose UValue *args via the
// urbi_native_method_fn typedef.  Same rationale as Phase 5/6/7/9 above —
// the function-pointer signature is pinned.
constParameterPointer:src/stdlib/debug_namespace.c

// audit:S44-followup — src/runtime/uunwind.c pattern_matches() at TRY_FRAME
// catch absorption is a documented M3 / FOUND-026 stub returning 1.  Wave 2
// will refine to class-pattern dispatch and the condition will become
// meaningful.  Cppcheck's flow analysis now detects the tautology — it was
// unflagged pre-S44 because the surrounding control-flow exposed fewer paths.
// File-wide suppression keeps the warning out of the gate until the Wave 2
// refinement lands; revisit then.
knownConditionTrueFalse:src/runtime/uunwind.c

// audit:v0.10.9-W3 — src/runtime/uunwind.c urbi_tag_block / _unblock /
// _freeze / _unfreeze use `vm` only for URBI_ASSERT_NOT_ISR and the
// NULL-arg validity check, then walk tag->member_strands_head and forward
// to urbi_strand_suspend / _resume (which themselves only read vm).
// cppcheck suggests `const struct UVM *` for the parameter, but the
// public C API surface in include/urbi/urbi.h pins `struct UVM *vm` to
// match the broader API convention (urbi_tag_stop / urbi_strand_cancel /
// urbi_throw etc.).  Const-qualifying would break ABI uniformity and
// force every caller through a const-cast.
constParameterPointer:src/runtime/uunwind.c

// audit:v0.10.9-W3 — src/tag/utag_native.c tag_freeze_native /
// tag_unfreeze_native and the new tag_frozen_native / tag_blocked_native
// load `t` from self.v.p and only read it.  cppcheck suggests
// `const UTag *`, but the helpers below (urbi_tag_freeze etc.) accept
// non-const UTag*.  Cascading const into urbi_tag_* signatures would
// break the public C API uniformity (see uunwind.c rationale above).
constVariablePointer:src/tag/utag_native.c

// audit:v094-repl-portability — src/repl/urepl_queue.c uses UREPL_MUTEX_LOCK /
// UREPL_COND_WAIT / UREPL_COND_BROADCAST macros (from src/repl/urepl_threading.h)
// that expand to pthread_mutex_lock / pthread_cond_wait / pthread_cond_broadcast
// on POSIX builds.  Cppcheck doesn't model the macro-hidden pthread semantics:
//   - constParameterPointer: cppcheck thinks `q` / `rb` could be const because
//     the macro takes &q->mutex (a member-address) rather than mutating q
//     directly — but pthread_mutex_lock DOES mutate the mutex (and so q's
//     contents).  Const-qualifying would fail to compile (pthread takes non-
//     const).
//   - knownConditionTrueFalse: cppcheck doesn't model pthread_cond_wait's
//     "release mutex, wait, reacquire mutex" semantics, so the post-wait
//     check of q->inited (set false during shutdown by another thread) looks
//     dead.
// Surfaced by the v0.9.4 typedef-shim swap (commit a8f121c) which replaced
// direct pthread_* calls with UREPL_* macros; the new indirection broke
// cppcheck's flow analysis.
constParameterPointer:src/repl/urepl_queue.c
knownConditionTrueFalse:src/repl/urepl_queue.c

// audit:v094-repl-portability — src/repl/urepl_dispatch.c dispatch_auth's
// `job` parameter is only read on both the POSIX and cooperative branches
// after Task 4's URBI_REPL_COOPERATIVE_ONLY split.  cppcheck suggests
// const-qualification, but `urbi_native_method_fn`-style dispatch entry
// points keep matching signatures across the call chain; cascading const
// into the dispatcher's contract is out of scope for the portability fix.
constParameterPointer:src/repl/urepl_dispatch.c

// audit:v0_10_9_W2_D3 — src/runtime/umacros.h urbi_strncpy_truncating is a
// bounded-copy helper whose loop condition `n + 1U < cap && src[n] != '\0'`
// safely stops on either bound.  When called with a constant cap larger
// than the literal string source (e.g., UVM_ERRMSG_CAP=128 with a 30-char
// literal in src/tag/utag_native.c:tag_stop_native), cppcheck's
// inter-procedural analysis flags the loop body as "out-of-bounds at
// src[126]" — but the `src[n] != '\0'` short-circuit fires first.  Other
// call sites pass variable cap (out_buf_size) so cppcheck cannot constant-
// propagate and the warning silently stays clear.  File-wide suppression
// because the helper itself is unchanged; every constant-cap caller would
// otherwise need a per-site suppression.
arrayIndexOutOfBoundsCond:src/runtime/umacros.h

// audit:v0.12.0-ros — src/ros/uros.c native-method callbacks
// (ros_init_method, ros_msg_method, ros_subscribe_method, ros_client_method,
// ros_service_method, ros_publisher_method, ros_inject_int32_method) expose
// UValue *args via the urbi_native_method_fn typedef.  cppcheck flags each
// as constParameterCallback, but const-qualifying args would cascade into
// every native-method registration site.  Same rationale as Phase 5/6/7/9
// above — the function-pointer signature is pinned and cannot be changed
// without breaking the public C API.
constParameterCallback:src/ros/uros.c

// audit:v0.12.0-ros-R1 — src/ros/uros.c urbi_ros_shutdown(vm) uses `vm` only
// for the owner-equality check (b->owner != vm); cppcheck suggests
// `const struct UVM *`.  The public C API surface in include/urbi/ros.h pins
// `struct UVM *vm` to match urbi_ros_pump / urbi_ros_register / urbi_ros_*
// uniformity (same rationale as the v0.10.9-W3 urbi_tag_block suppression for
// uunwind.c above).  Const-qualifying would break API uniformity and force
// callers through a const-cast.
constParameterPointer:src/ros/uros.c
